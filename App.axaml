<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MSX_GameTools"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MSX_GameTools.App"
             RequestedThemeVariant="Light"><!-- Hasta que se lean los ajustes, que mandan -->

  <!-- Sustituye al antiguo ViewModelFacctory: resuelve XxxViewModel -> Views.XxxView -->
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- Los iconos de las barras. Son trazos que heredan el Foreground, asi que siguen a
         la variante igual que el texto al que sustituyen. -->
    <icons:MaterialIconStyles />

    <!-- Fluent le da a las pestañas una fuente mucho mayor que la del resto de la
         interfaz y unas cabeceras muy altas. Va aqui y no en cada TabControl porque
         se quiere igual en las pestañas del centro y en las del lateral. MinHeight y
         Padding tambien: solo con la fuente, la tira se queda igual de gruesa con la
         letra pequeña flotando dentro. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- La linea de la pestaña seleccionada, fuera del texto.

         Fluent la mete dentro de la caja del contenido, alineada abajo, contando con que
         sus pestañas son altas y al texto le sobra sitio. Con el relleno de arriba, esa
         caja mide justo lo que el texto, asi que la linea le caia encima: medido, el texto
         ocupaba de 6 a 22 y la linea de 18 a 20.

         Subir el relleno no sirve: la caja se ajusta al texto pase lo que pase, y la
         cuenta sale que harian falta pestañas de 44 pixeles para separarlas asi, que es
         justo la altura que quitamos. Se baja la linea, que es la pieza que sobra ahi.

         Por transformacion y no por margen: la plantilla de Fluent le pone el margen como
         valor local, y en Avalonia un valor local gana a un Setter de estilo. Ademas asi
         no se toca la medida, solo donde se pinta. -->
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="RenderTransform" Value="translateY(6px)" />
    </Style>

    <!-- La fila seleccionada de cualquier lista. Fluent la pinta con el mismo azul en
         claro y en oscuro -medido, #0078D7 en las dos-, y sobre un fondo oscuro ese salto
         de luminosidad se lleva toda la atencion de la ventana. Con estos recursos el
         claro se queda exactamente como estaba y solo baja el oscuro.

         Los tres estados y no solo el base: el de raton encima tiene mas especificidad en
         Fluent y sin el la fila volvia al azul fuerte al pasar por encima. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppListSelection}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppListSelectionHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppListSelectionHover}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>

      <ResourceDictionary.MergedDictionaries>
        <!-- Los colores del cromo, por variante. Todo lo de abajo tira de ahí. -->
        <ResourceInclude Source="avares://MSX_GameTools/Themes/AppColors.axaml" />
      </ResourceDictionary.MergedDictionaries>

    <!-- Equivalente al ControlTemplate que en WPF convertía los RadioButton
         en ToggleButton. En Avalonia esto es un ControlTheme. -->
    <ControlTheme x:Key="ToggleRadioButton" TargetType="RadioButton">
      <Setter Property="Background" Value="{DynamicResource AppToolButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppToolButtonBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AppToolButtonForeground}" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AppToolButtonHoverBackground}" />
      </Style>

      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="{DynamicResource AppToolButtonCheckedForeground}" />
      </Style>
      <Style Selector="^:checked /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AppToolButtonCheckedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppToolButtonCheckedBorder}" />
      </Style>
    </ControlTheme>


    <ControlTheme x:Key="TileColorSwatch" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppSwatchBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AppSwatchHoverBorder}" />
      </Style>
    </ControlTheme>

    </ResourceDictionary>
  </Application.Resources>
</Application>
