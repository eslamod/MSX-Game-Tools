<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="180" d:DesignHeight="200"
             x:Class="MSX_GameTools.Views.PatternMovesPad"
             x:DataType="vm:IPatternMoves">

  <!-- The same pad for the tile editor and for the sprite editor: the eight moves are the
       same eight in both, and the commands are named once in IPatternMoves so that both
       editors have to answer to them. -->
  <!-- It hangs from a single button of the toolbar and not from eight of them because there
       is no room for eight: both canvases live in a column of 256 that is already full, and
       the bar underneath is what would end up on top of the thumbnails. -->

  <UserControl.Styles>
    <Style Selector="Button.move">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.move > icons|MaterialIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="4">
    <TextBlock Text="{l:Localize MovesTitle}" FontWeight="Bold" Margin="2,0,2,6" />

    <!-- The four shifts as a cross, which is the shape of what they do. The middle stays
         empty: there is no move that leaves the drawing where it is. -->
    <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
          HorizontalAlignment="Center">
      <Button x:Name="ShiftUpButton" Grid.Row="0" Grid.Column="1" Classes="move"
              Command="{Binding ShiftUpCommand}"
              ToolTip.Tip="{l:Localize MoveUpTip}">
        <icons:MaterialIcon Kind="ArrowUp" />
      </Button>

      <Button x:Name="ShiftLeftButton" Grid.Row="1" Grid.Column="0" Classes="move"
              Command="{Binding ShiftLeftCommand}"
              ToolTip.Tip="{l:Localize MoveLeftTip}">
        <icons:MaterialIcon Kind="ArrowLeft" />
      </Button>

      <Button x:Name="ShiftRightButton" Grid.Row="1" Grid.Column="2" Classes="move"
              Command="{Binding ShiftRightCommand}"
              ToolTip.Tip="{l:Localize MoveRightTip}">
        <icons:MaterialIcon Kind="ArrowRight" />
      </Button>

      <Button x:Name="ShiftDownButton" Grid.Row="2" Grid.Column="1" Classes="move"
              Command="{Binding ShiftDownCommand}"
              ToolTip.Tip="{l:Localize MoveDownTip}">
        <icons:MaterialIcon Kind="ArrowDown" />
      </Button>
    </Grid>

    <!-- The two mirrors and the two turns, apart from the shifts: these ones change the
         drawing, and the shifts only move it. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
      <Button x:Name="FlipHorizontalButton" Classes="move"
              Command="{Binding FlipHorizontalCommand}"
              ToolTip.Tip="{l:Localize MoveFlipHorizontalTip}">
        <icons:MaterialIcon Kind="FlipHorizontal" />
      </Button>

      <Button x:Name="FlipVerticalButton" Classes="move"
              Command="{Binding FlipVerticalCommand}"
              ToolTip.Tip="{l:Localize MoveFlipVerticalTip}">
        <icons:MaterialIcon Kind="FlipVertical" />
      </Button>

      <Button x:Name="RotateLeftButton" Classes="move"
              Command="{Binding RotateLeftCommand}"
              ToolTip.Tip="{l:Localize MoveRotateLeftTip}">
        <icons:MaterialIcon Kind="RotateLeft" />
      </Button>

      <Button x:Name="RotateRightButton" Classes="move"
              Command="{Binding RotateRightCommand}"
              ToolTip.Tip="{l:Localize MoveRotateRightTip}">
        <icons:MaterialIcon Kind="RotateRight" />
      </Button>
    </StackPanel>

    <!-- Said here and not only in the tooltips: the wrap around and the line colours are the
         two things that surprise, and they surprise once. -->
    <TextBlock Text="{l:Localize MovesNote}" TextWrapping="Wrap" MaxWidth="168"
               FontSize="11" Opacity="0.75" Margin="2,8,2,2" />
  </StackPanel>
</UserControl>
