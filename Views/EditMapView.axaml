<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="300"
             x:Class="MSX_GameTools.Views.EditMapView"
             x:DataType="vm:EditMapViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <!-- El titulo arriba, los botones abajo y lo de en medio con barra: al crecer el
       formulario, las filas Auto empujaban a Aceptar y Cancelar fuera del panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize NewMapTitle}" FontWeight="Bold" Margin="0,0,0,10" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize FormName}" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="{l:Localize NewMapHint}" />
    </Grid>

    <!-- El tamaño se pide al crear y no se deduce: un mapa vacío no tiene contenido del
         que sacarlo, y cambiarlo después es una operación aparte. -->
    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize NewMapColumns}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                     Minimum="1" Maximum="{Binding MaxSide}" Increment="1"
                     Value="{Binding Columns}" />
    </Grid>

    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize NewMapRows}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                     Minimum="1" Maximum="{Binding MaxSide}" Increment="1"
                     Value="{Binding Rows}" />
    </Grid>

    <!-- Con qué juego se dibuja. Un mapa son números de tile: sin saber de cuál son, no
         significan nada. -->
    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize NewMapTileSet}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding TileSets}"
                SelectedItem="{Binding TileSet}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TileSetEditorViewModel">
            <TextBlock Text="{Binding TileSet.Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- The other two bands, when the map is short enough to have them. In GRAPHIC 2 each
         third of the screen reads its own bank of patterns, so a map that fits in one screen
         can be drawn with a different tile set on each band. The top one is the map's own. -->
    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6" IsVisible="{Binding ShowsMiddleThird}">
      <TextBlock Grid.Column="0" Text="{l:Localize NewMapMiddleThird}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding TileSets}"
                SelectedItem="{Binding MiddleTileSet}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TileSetEditorViewModel">
            <TextBlock Text="{Binding TileSet.Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6" IsVisible="{Binding ShowsBottomThird}">
      <TextBlock Grid.Column="0" Text="{l:Localize NewMapBottomThird}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding TileSets}"
                SelectedItem="{Binding BottomTileSet}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TileSetEditorViewModel">
            <TextBlock Text="{Binding TileSet.Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <TextBlock Text="{l:Localize NewMapThirdsTip}" TextWrapping="Wrap" FontSize="11"
               Foreground="{DynamicResource AppTextSecondary}"
               Margin="0,0,0,8" IsVisible="{Binding ShowsMiddleThird}" />

    <!-- Que va a salir, segun el juego elegido. No se elige aqui: el tamaño del supertile
         es del juego, asi que preguntarlo por mapa dejaria a dos mapas del mismo juego
         pidiendo tamaños distintos. Se dice para no enterarse despues. -->
    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6" VerticalAlignment="Top">
      <TextBlock Grid.Column="0" Text="{l:Localize NewMapKind}" VerticalAlignment="Top" />
      <TextBlock Grid.Column="1" Text="{Binding KindLabel}" TextWrapping="Wrap"
                 Foreground="{DynamicResource AppTextSecondary}" />
    </Grid>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppTextError}"
               TextWrapping="Wrap" VerticalAlignment="Top"
               IsVisible="{Binding HasError}" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" MinWidth="90" Command="{Binding AcceptMapCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelMapCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
