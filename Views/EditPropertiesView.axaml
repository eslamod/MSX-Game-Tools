<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="300"
             x:Class="MSX_GameTools.Views.EditPropertiesView"
             x:DataType="vm:EditPropertiesViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <UserControl.Styles>
    <!-- El mismo boton que en las barras, con :is() porque el ojo es un ToggleButton. -->
    <Style Selector=":is(Button).tool">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style Selector=":is(Button).tool > icons|MaterialIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
  </UserControl.Styles>

  <!-- El titulo arriba, los botones abajo y lo de en medio con barra: con la seccion de
       supertiles las filas Auto empujaban a Aceptar y Cancelar fuera del panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{Binding Kind}" FontWeight="Bold" Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

    <Grid ColumnDefinitions="60,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{l:Localize FormName}" VerticalAlignment="Center" />
      <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name}" />
    </Grid>

    <!-- El fichero se enseña pero no se toca: renombrar el documento no renombra el
         fichero, que es cosa de donde lo guardes. -->
    <TextBlock Text="{Binding Where}"
               Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" />

    <TextBlock Text="{Binding Affected}"
               IsVisible="{Binding HasAffected}"
               Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" />

    <!-- Un juego que ya existe, con sus tiles dibujados, es justo el que uno quiere pasar
         a supertiles; volver a empezar de cero para eso no tiene sentido. -->
    <StackPanel IsVisible="{Binding IsTileSet}" Margin="0,10,0,0">

      <CheckBox Content="{l:Localize NewTileSetSuperTiles}" IsChecked="{Binding UseSuperTiles}" />

      <StackPanel Margin="24,0,0,0" IsEnabled="{Binding UseSuperTiles}">
        <Grid ColumnDefinitions="60,*" Margin="0,4,0,4">
          <TextBlock Grid.Column="0" Text="{l:Localize NewTileSetSuperWidth}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                         Minimum="1" Maximum="{Binding MaxSuperTileSide}" Increment="1"
                         Value="{Binding SuperTileWidth}" />
        </Grid>

        <Grid ColumnDefinitions="60,*" Margin="0,0,0,4">
          <TextBlock Grid.Column="0" Text="{l:Localize NewTileSetSuperHeight}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                         Minimum="1" Maximum="{Binding MaxSuperTileSide}" Increment="1"
                         Value="{Binding SuperTileHeight}" />
        </Grid>
      </StackPanel>

      <!-- Los dos efectos que no se ven venir: los bloques se ajustan y las celdas de los
           mapas ya dibujados cambian de significado sin cambiar de numero. -->
      <TextBlock Text="{Binding SuperTileWarning}"
                 IsVisible="{Binding HasSuperTileWarning}"
                 Foreground="{DynamicResource AppTextWarning}" TextWrapping="Wrap" Margin="0,6,0,0" />

      <!-- Los ocho atributos. Salen siempre los ocho, tengan nombre o no: un atributo es un
           bit, y los ocho bits estan ahi aunque no se usen. Dejar el nombre en blanco es
           como se dice que ese no se usa, y entonces no aparece al editar los tiles. -->
      <Border Height="1" Background="{DynamicResource AppSeparator}" Margin="0,14,0,10" />

      <TextBlock Text="{l:Localize TileAttributes}" FontWeight="Bold" Margin="0,0,0,4" />

      <TextBlock Text="{l:Localize TileAttributesNote}"
                 Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"
                 Margin="0,0,0,8" />

      <ItemsControl ItemsSource="{Binding Attributes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TileAttributeRowViewModel">
            <Grid ColumnDefinitions="24,*,Auto" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Text="{Binding Bit}" VerticalAlignment="Center"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource AppTextSecondary}" />
              <TextBox Grid.Column="1" Text="{Binding Name}" />

              <!-- El ojo tiñe en la rejilla los tiles que ya lo tienen puesto, para verlos
                   de un vistazo en vez de ir tile por tile. Surte efecto en el acto y no
                   al aceptar: no cambia el juego, cambia como se mira. -->
              <ToggleButton Grid.Column="2" Classes="tool" Margin="4,0,0,0"
                            IsChecked="{Binding IsWatched}"
                            IsEnabled="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            ToolTip.Tip="{l:Localize TileAttributeWatchTip}">
                <icons:MaterialIcon Kind="EyeOutline" />
              </ToggleButton>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

    <TextBlock Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Foreground="{DynamicResource AppTextError}"
               TextWrapping="Wrap"
               Margin="0,10,0,0" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"
                Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" MinWidth="85" Command="{Binding AcceptPropertiesCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="85" Command="{Binding CancelPropertiesCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
