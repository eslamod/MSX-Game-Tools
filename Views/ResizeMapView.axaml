<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="300"
             x:Class="MSX_GameTools.Views.ResizeMapView"
             x:DataType="vm:ResizeMapViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <!-- Los botones anclados abajo y el resto con barra: con la escala de la interfaz al
       200% el contenido mide el doble y los empujaba fuera del panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize ResizeTitle}" FontWeight="Bold" Margin="0,0,0,4" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

    <TextBlock Text="{Binding CurrentLabel}" Margin="0,0,0,10" />

    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize NewMapColumns}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                     Minimum="1" Maximum="{Binding MaxSide}" Increment="1"
                     Value="{Binding Columns}" />
    </Grid>

    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize NewMapRows}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                     Minimum="1" Maximum="{Binding MaxSide}" Increment="1"
                     Value="{Binding Rows}" />
    </Grid>

    <!-- Sin ancla solo se podria crecer por abajo y por la derecha, y alargar un nivel
         por el principio obligaria a repintarlo entero. -->
    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize ResizeAnchor}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Anchors}"
                SelectedItem="{Binding Anchor}"
                ToolTip.Tip="{l:Localize ResizeAnchorTip}" />
    </Grid>

    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondary}"
               Text="{l:Localize ResizeNote}" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppTextError}"
               TextWrapping="Wrap" Margin="0,8,0,0"
               IsVisible="{Binding HasError}" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" MinWidth="90" Command="{Binding AcceptResizeCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelResizeCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
