<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:loc="clr-namespace:MSX_GameTools.Localization"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="480"
             x:Class="MSX_GameTools.Views.EditPreferencesView"
             x:DataType="vm:EditPreferencesViewModel"
             Background="Gainsboro">

  <!-- El titulo arriba, los botones abajo y lo de en medio con barra: es el formulario mas
       alto del programa y con la escala al 200% no cabe, y sin esto los botones se iban
       por debajo del borde y no habia forma de aceptar ni de cancelar. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize PreferencesTitle}" FontWeight="Bold" Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="0">

    <Grid ColumnDefinitions="150,*" Margin="0,0,0,14">
      <TextBlock Grid.Column="0" Text="{l:Localize PreferencesLanguage}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding Language}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="loc:LanguageChoice">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <StackPanel Spacing="6">

      <!-- Agranda todo el programa, no solo los lienzos: en una pantalla densa al 100%
           tambien se quedan pequeños los menus, el arbol y las etiquetas. -->
      <Grid ColumnDefinitions="150,*" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Text="{l:Localize PreferencesScale}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Scales}"
                  SelectedItem="{Binding Scale}"
                  ToolTip.Tip="{l:Localize PreferencesScaleTip}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ScaleChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <TextBlock Text="{l:Localize PreferencesZoom}" FontWeight="Bold" Margin="0,0,0,2" />

      <!-- Con que zoom se abre cada sitio. Lo que ya este abierto se queda con el suyo
           hasta que se vuelva a montar su pestaña. -->
      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Text="{l:Localize PreferencesSpriteCanvas}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding CanvasZooms}"
                  SelectedValue="{Binding SpriteCanvasZoom}"
                  SelectedValueBinding="{Binding Value}"
                  DisplayMemberBinding="{Binding Label}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Text="{l:Localize PreferencesSpriteThumbnails}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding FourZooms}"
                  SelectedValue="{Binding SpriteThumbnailZoom}"
                  SelectedValueBinding="{Binding Value}"
                  DisplayMemberBinding="{Binding Label}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Text="{l:Localize PreferencesTileCanvas}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding CanvasZooms}"
                  SelectedValue="{Binding TileCanvasZoom}"
                  SelectedValueBinding="{Binding Value}"
                  DisplayMemberBinding="{Binding Label}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Text="{l:Localize PreferencesTileThumbnails}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding FourZooms}"
                  SelectedValue="{Binding TileThumbnailZoom}"
                  SelectedValueBinding="{Binding Value}"
                  DisplayMemberBinding="{Binding Label}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Text="{l:Localize PreferencesBlockGrid}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding ThreeZooms}"
                  SelectedValue="{Binding BlockGridZoom}"
                  SelectedValueBinding="{Binding Value}"
                  DisplayMemberBinding="{Binding Label}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Text="{l:Localize PreferencesBlockTiles}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding ThreeZooms}"
                  SelectedValue="{Binding BlockTileZoom}"
                  SelectedValueBinding="{Binding Value}"
                  DisplayMemberBinding="{Binding Label}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Text="{l:Localize PreferencesMapTiles}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding MapZooms}"
                  SelectedValue="{Binding MapTileZoom}"
                  SelectedValueBinding="{Binding Value}"
                  DisplayMemberBinding="{Binding Label}" />
      </Grid>

    </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"
                Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" MinWidth="85" Command="{Binding AcceptPreferencesCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="85" Command="{Binding CancelPreferencesCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
