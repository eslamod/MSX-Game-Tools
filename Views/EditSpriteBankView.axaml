<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="MSX_GameTools.Views.EditSpriteBankView"
             x:DataType="vm:EditSpriteBankViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <!-- Los botones anclados abajo y el resto con barra: con la escala de la interfaz al
       200% el contenido mide el doble y los empujaba fuera del panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize NewSpriteBankTitle}" FontWeight="Bold" Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

    <Grid ColumnDefinitions="60,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{l:Localize FormName}" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="{l:Localize NewSpriteBankHint}" />
    </Grid>

    <Grid ColumnDefinitions="60,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{l:Localize NewSpriteBankType}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding SpriteTypes}"
                SelectedItem="{Binding Type}" />
    </Grid>

    <!-- Cuantos patrones tiene. Los 64 son de la tabla de la VRAM, no del banco: un juego
         que los tenga en ROM y vaya redefiniendo los de cada animacion puede tener muchos
         mas. El aviso va aqui al lado y no en un dialogo, porque es una decision de como
         esta hecho el juego y no un error que haya que confirmar. -->
    <Grid ColumnDefinitions="60,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{l:Localize NewSpriteBankSize}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1">
        <ComboBox HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Capacities}"
                  SelectedItem="{Binding Capacity}" />
        <TextBlock Text="{l:Localize NewSpriteBankOverVram}" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondary}" Margin="0,4,0,0"
                   IsVisible="{Binding IsOverVram}" />
      </StackPanel>
    </Grid>

    <!-- Con que colores se dibuja. Se pregunta aqui porque la paleta va dentro del
         fichero del banco: es suya, no un ajuste del programa. -->
    <Grid ColumnDefinitions="60,*">
      <TextBlock Grid.Column="0" Text="{l:Localize FormPalette}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Palettes}"
                SelectedItem="{Binding Palette}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="entities:ColorPalette">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- Reemplaza al MessageBox.Show que la versión WPF lanzaba desde el ViewModel. -->
    <TextBlock Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Foreground="{DynamicResource AppTextError}"
               TextWrapping="Wrap"
               Margin="0,10,0,0" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"
                Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" MinWidth="85" Command="{Binding AcceptSpriteBankCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="85" Command="{Binding CancelSpriteBankCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
