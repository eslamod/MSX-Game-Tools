<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:e="clr-namespace:MSX_GameTools.Entities"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="320"
             x:Class="MSX_GameTools.Views.ExportView"
             x:DataType="vm:ExportViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <!-- Title at the top, buttons at the bottom and a scroll bar in between, like the other
       forms of the side panel: the list of files grows, and it cannot be allowed to push
       Accept out of the panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{Binding Header}" FontWeight="Bold" Margin="0,0,0,10" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <Grid ColumnDefinitions="80,*" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="{l:Localize ExportFormatLabel}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Formats}"
                    SelectedItem="{Binding Format}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ExportChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- The question of the screens goes before the destination because it changes what
             the destination is: with it ticked a folder is chosen, and without it a file. -->
        <CheckBox Content="{l:Localize ExportByScreens}"
                  IsChecked="{Binding ByScreens}"
                  IsVisible="{Binding ShowsScreens}" Margin="0,2,0,0" />

        <TextBlock Text="{l:Localize ExportByScreensTip}" IsVisible="{Binding ShowsScreens}"
                   Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6" />

        <!-- All or only one. Both buttons show together so that both choices are seen; with a
             single box, the one of "only one", the other would have to be guessed. -->
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0"
                    IsVisible="{Binding ShowsScreenOptions}">
          <RadioButton GroupName="ExportScreens" Content="{l:Localize ExportAllScreens}"
                       IsChecked="{Binding AllScreens}" />
          <RadioButton GroupName="ExportScreens" Content="{l:Localize ExportOneScreen}"
                       IsChecked="{Binding OneScreen}" />
        </StackPanel>

        <!-- Which one, as the label of the editor reads it: column and row, from one. -->
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,6,0,0"
                    IsVisible="{Binding ShowsScreenPick}">
          <TextBlock Text="{l:Localize ExportScreenWhich}" VerticalAlignment="Center" />
          <NumericUpDown Width="95" ShowButtonSpinner="True" FormatString="0"
                         Minimum="1" Maximum="1024" Increment="1"
                         Value="{Binding ScreenColumn}" />
          <TextBlock Text="-" VerticalAlignment="Center" />
          <NumericUpDown Width="95" ShowButtonSpinner="True" FormatString="0"
                         Minimum="1" Maximum="1024" Increment="1"
                         Value="{Binding ScreenRow}" />
        </StackPanel>

        <!-- The index only with all of them: it speaks of the whole batch, and one screen on
             its own leaves the index there was as it was. -->
        <CheckBox Content="{l:Localize ExportScreenIndex}"
                  IsChecked="{Binding ScreenIndex}"
                  IsVisible="{Binding ShowsScreenIndex}" Margin="12,6,0,0" />

        <TextBlock Text="{l:Localize ExportScreenIndexTip}" IsVisible="{Binding ShowsScreenIndex}"
                   Opacity="0.7" TextWrapping="Wrap" Margin="12,0,0,0" />

        <!-- The pages of the mapper, only with the index: they change what the index says, and
             nothing else. -->
        <Grid ColumnDefinitions="Auto,*" Margin="24,6,0,0" IsVisible="{Binding ShowsScreenPages}">
          <TextBlock Grid.Column="0" Text="{l:Localize ExportScreenPages}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="110"
                    ItemsSource="{Binding PageSizes}"
                    SelectedItem="{Binding ScreenPages}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <TextBlock Text="{l:Localize ExportScreenPagesTip}" IsVisible="{Binding ShowsScreenPages}"
                   Opacity="0.7" TextWrapping="Wrap" Margin="24,0,0,0" />

        <CheckBox Content="{l:Localize ExportScreenHeader}"
                  IsChecked="{Binding ScreenHeader}"
                  IsVisible="{Binding ShowsScreenOptions}" Margin="12,6,0,0" />

        <TextBlock Text="{l:Localize ExportScreenHeaderTip}" IsVisible="{Binding ShowsScreenOptions}"
                   Opacity="0.7" TextWrapping="Wrap" Margin="12,0,0,6" />

        <!-- The other files take their name from whatever is chosen here, which is what the
             export already did: one name is asked for and the rest are called after it. -->
        <Grid ColumnDefinitions="80,*,Auto" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="{l:Localize ExportTo}" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Destination}"
                   PlaceholderText="{l:Localize ExportToHint}" />
          <Button Grid.Column="2" Content="..." MinWidth="34" Margin="4,0,0,0"
                  Command="{Binding BrowseCommand}"
                  ToolTip.Tip="{l:Localize ExportBrowseTip}" />
        </Grid>

        <!-- The ROM question goes above the list because it puts a file in it. Off by
             default: it is for whoever does not know yet what to do with the tables. -->
        <CheckBox Content="{l:Localize ExportExampleRom}"
                  IsChecked="{Binding WantsExampleRom}"
                  IsVisible="{Binding ShowsExampleRom}" Margin="0,2,0,0" />

        <TextBlock Text="{l:Localize ExportExampleRomTip}" IsVisible="{Binding ShowsExampleRom}"
                   Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6" />

        <!-- And the assembler only with the box ticked: with it unticked there is no asm of
             ours to write, and asking would be a question with nothing hanging on it. -->
        <Grid ColumnDefinitions="80,*" Margin="0,0,0,6" IsVisible="{Binding ShowsAssembler}">
          <TextBlock Grid.Column="0" Text="{l:Localize ExportAssembler}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Assemblers}"
                    SelectedItem="{Binding Assembler}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="e:AsmDialect">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- What is going to come out, before a single file is written. The picker of the
             system only warns about the one that gets named, and a tile set writes up to
             four. -->
        <TextBlock Text="{l:Localize ExportFiles}" FontWeight="Bold" Margin="0,8,0,4" />

        <ItemsControl ItemsSource="{Binding Files}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ExportFileRow">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           FontFamily="{StaticResource CodeFont}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{l:Localize ExportExists}"
                           IsVisible="{Binding Exists}"
                           Foreground="{DynamicResource AppTextWarning}" Margin="6,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- And the ones that do not fit, counted: a hundred names are not read, but knowing
             there are a hundred is needed. -->
        <TextBlock Text="{Binding More}" IsVisible="{Binding HasMore}"
                   Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />

        <TextBlock Text="{Binding Overwrites}" IsVisible="{Binding HasOverwrites}"
                   Foreground="{DynamicResource AppTextWarning}" TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <!-- What an earlier export left and this one does not write: said, not deleted. -->
        <TextBlock Text="{Binding Leftovers}" IsVisible="{Binding HasLeftovers}"
                   Foreground="{DynamicResource AppTextWarning}" TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   Foreground="{DynamicResource AppTextError}" TextWrapping="Wrap"
                   Margin="0,6,0,0" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" MinWidth="90" Command="{Binding AcceptExportCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelExportCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
