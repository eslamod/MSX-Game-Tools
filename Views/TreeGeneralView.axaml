<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             mc:Ignorable="d" d:DesignWidth="225" d:DesignHeight="400"
             x:Class="MSX_GameTools.Views.TreeGeneralView"
             x:DataType="vm:TreeGeneralViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <!-- El doble clic y el menú contextual se resuelven en el code-behind: un
       ContextMenu vive en su propio árbol visual (es un popup), así que desde dentro
       no se llega al ViewModel con $parent, y a DoubleTapped no se le puede enlazar
       un comando. Desde el code-behind los dos gestos son tres líneas. -->
  <TreeView x:Name="ProjectTree"
            ItemsSource="{Binding PrimaryNodes}"
            Background="{DynamicResource AppPanelBackground}"
            DoubleTapped="OnItemDoubleTapped"
            KeyDown="OnTreeKeyDown">
    <TreeView.ItemTemplate>
      <!-- El HierarchicalDataTemplate de WPF es TreeDataTemplate en Avalonia. -->
      <TreeDataTemplate DataType="entities:ItemTree" x:DataType="entities:ItemTree"
                        ItemsSource="{Binding Childs}">
        <TextBlock Text="{Binding Label}">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{l:Localize TreeOpen}"
                        IsEnabled="{Binding IsPanelNode}"
                        Click="OnOpenItem" />
              <MenuItem Header="{l:Localize TreeProperties}"
                        InputGesture="F2"
                        IsEnabled="{Binding IsPanelNode}"
                        Click="OnShowProperties" />
              <Separator />
              <MenuItem Header="{l:Localize TreeDelete}"
                        IsEnabled="{Binding CanDelete}"
                        Click="OnDeleteItem" />
            </ContextMenu>
          </TextBlock.ContextMenu>
        </TextBlock>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
