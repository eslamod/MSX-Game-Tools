<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:entities="clr-namespace:MSX_GameTools.Entities"
        xmlns:views="clr-namespace:MSX_GameTools.Views"
        xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
        xmlns:l="clr-namespace:MSX_GameTools.Localization"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="MSX_GameTools.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}" Width="900" Height="560">

  <Window.Styles>
    <!-- Los de junto a los desplegables: pequeños, que acompañan a un ComboBox y no
         tienen que competir con el. -->
    <Style Selector="Button.bar > icons|MaterialIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <!-- La aspa de cerrar pestaña: del tamaño del rotulo que la acompaña, no del de un
         boton de barra. Es un adorno del texto. -->
    <Style Selector="Button.close > icons|MaterialIcon">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
    </Style>
  </Window.Styles>

  <!-- El InputGesture del menu solo se dibuja; para que la tecla haga algo hace falta
       decirlo aqui. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveDocumentAsCommand}" />
  </Window.KeyBindings>

  <!-- La escala de la interfaz, envolviendo todo. De layout y no de render: una de render
       estiraria los pixeles ya dibujados y el texto saldria borroso; con esta se rehace la
       disposicion y las letras se dibujan al tamaño nuevo. -->
  <LayoutTransformControl x:Name="ScaledRoot">
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding Preferences.InterfaceScale}"
                      ScaleY="{Binding Preferences.InterfaceScale}" />
    </LayoutTransformControl.LayoutTransform>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Menu Grid.Row="0">
      <!-- Los menus van por cosa (sprites, tiles, mapas) y no por verbo, que es como esta
           organizado el arbol del proyecto y por tanto como se busca. Asi lo que se
           exporta de tiles queda al lado de lo que se importa de tiles. -->
      <MenuItem Header="{l:Localize MenuFile}">
        <!-- El proyecto es un indice de lo demas: guardarlo guarda todo lo que agrupa. -->
        <MenuItem Header="{l:Localize MenuNewProject}" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="{l:Localize MenuOpenProject}" InputGesture="Ctrl+O"
                  Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="{l:Localize MenuSaveProject}" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="{l:Localize MenuSaveProjectAs}" Command="{Binding SaveProjectAsCommand}" />
        <Separator />
        <!-- Abrir es uno solo: mira el fichero y sabe de que es. -->
        <MenuItem Header="{l:Localize MenuOpen}" Command="{Binding OpenCommand}" />

        <!-- Los recientes salen de una lista, asi que este submenu no puede llevar ademas
             una entrada suya escrita a mano: ItemsSource sustituye a los hijos. Por eso
             vaciar la lista va fuera, aqui debajo. -->
        <MenuItem Header="{l:Localize MenuRecent}"
                  ItemsSource="{Binding Recent.Items}"
                  IsEnabled="{Binding !Recent.IsEmpty}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" x:DataType="entities:RecentItem"
                          BasedOn="{StaticResource {x:Type MenuItem}}">
              <!-- El nombre del fichero, que la ruta entera no cabe en un menu; la ruta va
                   en la ayuda emergente, que es donde se mira cuando hay dos que se llaman
                   igual en carpetas distintas. -->
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
              <Setter Property="Command"
                      Value="{Binding $parent[Menu].((vm:MainWindowViewModel)DataContext).OpenRecentCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <MenuItem Header="{l:Localize MenuRecentClear}"
                  IsEnabled="{Binding !Recent.IsEmpty}"
                  Command="{Binding ClearRecentCommand}" />
        <MenuItem Header="{l:Localize MenuSave}" InputGesture="Ctrl+S"
                  Command="{Binding SaveDocumentCommand}" />
        <MenuItem Header="{l:Localize MenuSaveAs}" InputGesture="Ctrl+Shift+S"
                  Command="{Binding SaveDocumentAsCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuPreferences}" Command="{Binding ShowPreferencesCommand}" />
        <Separator />
        <!-- Cierra la ventana, para pasar por el mismo aviso de cambios sin guardar
             que la aspa del titulo. -->
        <MenuItem Header="{l:Localize MenuExit}" Click="OnExit" />
      </MenuItem>

      <MenuItem Header="{l:Localize MenuSprites}">
        <MenuItem Header="{l:Localize MenuNewSpriteBank}" Command="{Binding AddSpriteBankCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuImportSpriteSheet}" Command="{Binding ImportSpriteSheetCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuExportToBinary}" Command="{Binding ExportSpriteBankBinaryCommand}" />
        <MenuItem Header="{l:Localize MenuExportToAssembler}" Command="{Binding ExportSpriteBankAssemblerCommand}" />
        <MenuItem Header="{l:Localize MenuExportPatternRange}" Command="{Binding ExportPatternRangeCommand}" />
      </MenuItem>

      <MenuItem Header="{l:Localize MenuTiles}">
        <MenuItem Header="{l:Localize MenuNewTileSet}" Command="{Binding AddTileSetCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize TreeBlocks}" Command="{Binding ShowBlocksCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuImportFromPng}" Command="{Binding ImportTileSetPngCommand}" />
        <MenuItem Header="{l:Localize MenuExportToPng}" Command="{Binding ExportTileSetPngCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuExportToBinary}" Command="{Binding ExportTileSetBinaryCommand}" />
        <MenuItem Header="{l:Localize MenuExportToAssembler}" Command="{Binding ExportTileSetAssemblerCommand}" />
      </MenuItem>

      <MenuItem Header="{l:Localize MenuMaps}">
        <MenuItem Header="{l:Localize MenuNewMap}" Command="{Binding AddMapCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuResizeMap}" Command="{Binding ResizeMapCommand}" />
        <MenuItem Header="{l:Localize MenuReplaceTiles}" Command="{Binding ReplaceTilesCommand}" />
        <MenuItem Header="{l:Localize MenuShiftReport}" Command="{Binding ShiftReportCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuImportFromCsv}" Command="{Binding ImportMapCsvCommand}" />
        <MenuItem Header="{l:Localize MenuImportFromBinary}" Command="{Binding ImportMapBinaryCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuExportToCsv}" Command="{Binding ExportMapCsvCommand}" />
        <MenuItem Header="{l:Localize MenuExportToBinary}" Command="{Binding ExportMapBinaryCommand}" />
        <MenuItem Header="{l:Localize MenuExportToAssembler}" Command="{Binding ExportMapAssemblerCommand}" />
      </MenuItem>
      <!-- Cargar una paleta no esta aqui: la trae Abrir, como todo lo demas. -->
      <MenuItem Header="{l:Localize MenuPalette}">
        <MenuItem Header="{l:Localize MenuNewPalette}" Command="{Binding AddPaletteCommand}" />
        <MenuItem Header="{l:Localize MenuEditPalette}" Command="{Binding EditPaletteCommand}" />
        <MenuItem Header="{l:Localize MenuDeletePalette}" Command="{Binding DeletePaletteCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuSavePaletteAs}" Command="{Binding SavePaletteCommand}" />
        <Separator />
        <MenuItem Header="{l:Localize MenuExportToBinary}" Command="{Binding ExportPaletteBinaryCommand}" />
        <MenuItem Header="{l:Localize MenuExportToAssembler}" Command="{Binding ExportPaletteAssemblerCommand}" />
      </MenuItem>
    </Menu>

    <!-- DockPanel y no un StackPanel con FlowDirection invertido: asi las paletas
         se anclan a la izquierda y los Add a la derecha sin pelearse con el flujo. -->
    <DockPanel Grid.Row="1" Background="{DynamicResource AppPanelBackground}">

      <!-- Las paletas del proyecto. Cual usa cada documento lo lleva el documento, que
           la guarda dentro de su fichero: esto enseña la del que este delante. -->
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="4,2">
        <TextBlock Text="{l:Localize BarPalette}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox Width="160"
                  ItemsSource="{Binding Palettes.Palettes}"
                  SelectedItem="{Binding Palettes.ActivePalette}"
                  ToolTip.Tip="{l:Localize BarPaletteTip}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="entities:ColorPalette">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- La E de editar era la unica letra suelta de toda la barra, y una letra sola
             no dice nada en ningun idioma. -->
        <Button Classes="bar" Width="28" Margin="6,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding AddPaletteCommand}"
                ToolTip.Tip="{l:Localize BarPaletteAddTip}">
          <icons:MaterialIcon Kind="Plus" />
        </Button>
        <Button Classes="bar" Width="28" Margin="2,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding EditPaletteCommand}"
                ToolTip.Tip="{l:Localize BarPaletteEditTip}">
          <icons:MaterialIcon Kind="Pencil" />
        </Button>
        <Button Classes="bar" Width="28" Margin="2,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding DeletePaletteCommand}"
                ToolTip.Tip="{l:Localize BarPaletteDeleteTip}">
          <icons:MaterialIcon Kind="Minus" />
        </Button>
      </StackPanel>

      <!-- Imagenes de referencia. Aqui va la gestion (cargar y borrar el fichero), no
           la eleccion: que fondo lleva cada grupo se decide en el panel del grupo,
           porque es estado suyo y no del espacio de trabajo. -->
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,2,4,2">
        <TextBlock Text="{l:Localize BarBackground}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox Width="160"
                  ItemsSource="{Binding Backgrounds.Images}"
                  SelectedItem="{Binding Backgrounds.SelectedImage}"
                  ToolTip.Tip="{l:Localize BarBackgroundTip}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="entities:ReferenceImage">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- Este no es un mas: abre el dialogo de fichero para traer una imagen de
             fuera, y una carpeta lo dice mejor que un signo. -->
        <Button Classes="bar" Width="28" Margin="6,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding LoadBackgroundCommand}"
                ToolTip.Tip="{l:Localize BarBackgroundAddTip}">
          <icons:MaterialIcon Kind="FolderImage" />
        </Button>
        <Button Classes="bar" Width="28" Margin="2,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding DeleteBackgroundCommand}"
                ToolTip.Tip="{l:Localize BarBackgroundDeleteTip}">
          <icons:MaterialIcon Kind="Minus" />
        </Button>
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <!-- Estos tres se quedan solo con el rotulo. Llevaban icono y texto, y con eso el
             ultimo acababa en 1950 sobre una ventana de 1920: es lo que queda de un 4K al
             200%, y esta barra ya iba al limite. El rotulo dice que se crea, que es lo
             unico que hacen; el icono era adorno y ademas el que no cabia. -->
        <Button Content="{l:Localize BarAddMap}" MinWidth="90" Margin="4" Command="{Binding AddMapCommand}" />
        <Button Content="{l:Localize BarAddTileSet}" MinWidth="90" Margin="4" Command="{Binding AddTileSetCommand}" />
        <Button Content="{l:Localize BarAddSpriteBank}" MinWidth="90" Margin="4" Command="{Binding AddSpriteBankCommand}" />
      </StackPanel>

      <Border />
    </DockPanel>

    <Grid x:Name="MainArea" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="3" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="3" />
        <!-- Ni Auto ni enlazada: con Auto la columna toma el ancho que pide el contenido
             (los 32 tiles del selector de bloques) y se sale, y un enlace no le llega a
             la definicion de columna, que no esta en el arbol. La lleva el code-behind. -->
        <ColumnDefinition Width="0" MinWidth="0" MaxWidth="0" />
      </Grid.ColumnDefinitions>

      <views:TreeGeneralView Grid.Column="0" DataContext="{Binding TreeGeneralVm}" />

      <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource AppSeparator}" ResizeDirection="Columns" />

      <TabControl Grid.Column="2"
                  ItemsSource="{Binding Tabs}"
                  SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemTemplate>
          <!-- Plantilla de la cabecera de la pestaña. El contenido lo resuelve el ViewLocator. -->
          <DataTemplate x:DataType="vm:PanelBaseViewModel">
            <!-- Margen abajo: la linea que marca la pestaña seleccionada se alinea al
                 fondo de este bloque, no al de la pestaña, asi que sin aire se le queda
                 rozando el texto. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <!-- TabLabel y no Header: lleva el asterisco de lo que esta sin guardar. -->
              <TextBlock Text="{Binding TabLabel}" VerticalAlignment="Center" />

              <!-- Cerrar no es eliminar: la pestaña se va de la vista pero el elemento
                   sigue en el arbol, y un doble clic alli la trae de vuelta con el
                   estado que tenia. Eliminar de verdad esta en el menu del arbol. -->
              <Button Classes="close" Padding="4,0" Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0"
                      Command="{Binding $parent[TabControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{l:Localize TabCloseTip}">
                <icons:MaterialIcon Kind="Close" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>

      <GridSplitter Grid.Column="3" Width="3" Background="{DynamicResource AppSeparator}" ResizeDirection="Columns"
                    IsVisible="{Binding RightPanViewModel, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Pestañas y no un solo panel: los formularios de un uso conviven con las
           herramientas que se quedan puestas, como los bloques de un juego de tiles. -->
      <TabControl Grid.Column="4"
                  ItemsSource="{Binding RightPanels}"
                  SelectedItem="{Binding RightPanViewModel}"
                  IsVisible="{Binding RightPanViewModel, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PanelBaseViewModel">
            <!-- Margen abajo: la linea que marca la pestaña seleccionada se alinea al
                 fondo de este bloque, no al de la pestaña, asi que sin aire se le queda
                 rozando el texto. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <!-- TabLabel y no Header: lleva el asterisco de lo que esta sin guardar. -->
              <TextBlock Text="{Binding TabLabel}" VerticalAlignment="Center" />
              <Button Classes="close" Padding="4,0" Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0"
                      Command="{Binding $parent[TabControl].((vm:MainWindowViewModel)DataContext).CloseRightPanelCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{l:Localize PanelCloseTip}">
                <icons:MaterialIcon Kind="Close" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>
    </Grid>

    <!-- Avalonia no tiene StatusBar; un Border con el texto hace el mismo papel. -->
    <Border Grid.Row="3" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppSeparator}" BorderThickness="0,1,0,0" Padding="8,4">
      <TextBlock Text="MSX Game Tools" VerticalAlignment="Center" />
    </Border>

  </Grid>
  </LayoutTransformControl>
</Window>
