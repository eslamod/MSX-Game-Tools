<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:entities="clr-namespace:MSX_GameTools.Entities"
        xmlns:views="clr-namespace:MSX_GameTools.Views"
        xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="MSX_GameTools.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MSX Game Editor" Width="900" Height="560">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Menu Grid.Row="0">
      <MenuItem Header="File">
        <MenuItem Header="Add sprite bank" Command="{Binding AddSpriteBankCommand}" />
        <MenuItem Header="Add tileset" Command="{Binding AddTileSetCommand}" />
        <MenuItem Header="Add map" Command="{Binding AddMapCommand}" />
        <Separator />
        <MenuItem Header="Load sprite bank..." Command="{Binding LoadSpriteBankCommand}" />
        <MenuItem Header="Save sprite bank as..." Command="{Binding SaveSpriteBankCommand}" />
        <Separator />
        <MenuItem Header="Export sprite bank (binary)..." Command="{Binding ExportSpriteBankBinaryCommand}" />
        <MenuItem Header="Export sprite bank (asm)..." Command="{Binding ExportSpriteBankAssemblerCommand}" />
        <Separator />
        <MenuItem Header="Load tileset..." Command="{Binding LoadTileSetCommand}" />
        <MenuItem Header="Save tileset as..." Command="{Binding SaveTileSetCommand}" />
        <MenuItem Header="Export tileset (binary)..." Command="{Binding ExportTileSetBinaryCommand}" />
        <MenuItem Header="Export tileset (asm)..." Command="{Binding ExportTileSetAssemblerCommand}" />
        <MenuItem Header="Export tileset to png..." Command="{Binding ExportTileSetPngCommand}" />
        <MenuItem Header="Import tileset from png..." Command="{Binding ImportTileSetPngCommand}" />
        <Separator />
        <MenuItem Header="Load map..." Command="{Binding LoadMapCommand}" />
        <MenuItem Header="Save map as..." Command="{Binding SaveMapCommand}" />
        <MenuItem Header="Export map to csv..." Command="{Binding ExportMapCsvCommand}" />
        <MenuItem Header="Import map from csv..." Command="{Binding ImportMapCsvCommand}" />
        <MenuItem Header="Export map (binary)..." Command="{Binding ExportMapBinaryCommand}" />
        <MenuItem Header="Export map (asm)..." Command="{Binding ExportMapAssemblerCommand}" />
        <MenuItem Header="Import map from binary..." Command="{Binding ImportMapBinaryCommand}" />
        <Separator />
        <MenuItem Header="Exit" />
      </MenuItem>
      <MenuItem Header="Palette">
        <MenuItem Header="New palette" Command="{Binding AddPaletteCommand}" />
        <MenuItem Header="Edit palette" Command="{Binding EditPaletteCommand}" />
        <MenuItem Header="Delete palette" Command="{Binding DeletePaletteCommand}" />
        <Separator />
        <MenuItem Header="Load palette..." Command="{Binding LoadPaletteCommand}" />
        <MenuItem Header="Save palette as..." Command="{Binding SavePaletteCommand}" />
        <Separator />
        <MenuItem Header="Export palette (binary)..." Command="{Binding ExportPaletteBinaryCommand}" />
        <MenuItem Header="Export palette (asm)..." Command="{Binding ExportPaletteAssemblerCommand}" />
      </MenuItem>
    </Menu>

    <!-- DockPanel y no un StackPanel con FlowDirection invertido: asi las paletas
         se anclan a la izquierda y los Add a la derecha sin pelearse con el flujo. -->
    <DockPanel Grid.Row="1" Background="Gainsboro">

      <!-- Paletas: recurso comun a todos los modulos, no del editor de sprites. -->
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="4,2">
        <TextBlock Text="Palette" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox Width="160"
                  ItemsSource="{Binding Palettes.Palettes}"
                  SelectedItem="{Binding Palettes.ActivePalette}"
                  ToolTip.Tip="Paleta activa">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="entities:ColorPalette">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="+" Width="28" Margin="6,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding AddPaletteCommand}"
                ToolTip.Tip="Crear una paleta a partir de la activa" />
        <Button Content="E" Width="28" Margin="2,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding EditPaletteCommand}"
                ToolTip.Tip="Editar la paleta activa" />
        <Button Content="-" Width="28" Margin="2,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding DeletePaletteCommand}"
                ToolTip.Tip="Eliminar la paleta activa" />
      </StackPanel>

      <!-- Imagenes de referencia. Aqui va la gestion (cargar y borrar el fichero), no
           la eleccion: que fondo lleva cada grupo se decide en el panel del grupo,
           porque es estado suyo y no del espacio de trabajo. -->
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,2,4,2">
        <TextBlock Text="Fondo" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox Width="160"
                  ItemsSource="{Binding Backgrounds.Images}"
                  SelectedItem="{Binding Backgrounds.SelectedImage}"
                  ToolTip.Tip="Imagenes de referencia cargadas">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="entities:ReferenceImage">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="+" Width="28" Margin="6,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding LoadBackgroundCommand}"
                ToolTip.Tip="Cargar una imagen de referencia" />
        <Button Content="-" Width="28" Margin="2,0,0,0"
                HorizontalContentAlignment="Center"
                Command="{Binding DeleteBackgroundCommand}"
                ToolTip.Tip="Eliminar la imagen seleccionada y todos sus fondos" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Add Map" Width="80" Margin="4" Command="{Binding AddMapCommand}" />
        <Button Content="Add Tileset" Width="100" Margin="4" Command="{Binding AddTileSetCommand}" />
        <Button Content="Add sprite Bank" Width="128" Margin="4" Command="{Binding AddSpriteBankCommand}" />
      </StackPanel>

      <Border />
    </DockPanel>

    <Grid x:Name="MainArea" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="3" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="3" />
        <!-- Ni Auto ni enlazada: con Auto la columna toma el ancho que pide el contenido
             (los 32 tiles del selector de bloques) y se sale, y un enlace no le llega a
             la definicion de columna, que no esta en el arbol. La lleva el code-behind. -->
        <ColumnDefinition Width="0" MinWidth="0" MaxWidth="0" />
      </Grid.ColumnDefinitions>

      <views:TreeGeneralView Grid.Column="0" DataContext="{Binding TreeGeneralVm}" />

      <GridSplitter Grid.Column="1" Width="3" Background="DarkGray" ResizeDirection="Columns" />

      <TabControl Grid.Column="2"
                  ItemsSource="{Binding Tabs}"
                  SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemTemplate>
          <!-- Plantilla de la cabecera de la pestaña. El contenido lo resuelve el ViewLocator. -->
          <DataTemplate x:DataType="vm:PanelBaseViewModel">
            <!-- Margen abajo: la linea que marca la pestaña seleccionada se alinea al
                 fondo de este bloque, no al de la pestaña, asi que sin aire se le queda
                 rozando el texto. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />

              <!-- Cerrar no es eliminar: la pestaña se va de la vista pero el elemento
                   sigue en el arbol, y un doble clic alli la trae de vuelta con el
                   estado que tenia. Eliminar de verdad esta en el menu del arbol. -->
              <Button Content="✕" FontSize="10" Padding="4,0" Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0"
                      Command="{Binding $parent[TabControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="Cerrar la pestaña" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>

      <GridSplitter Grid.Column="3" Width="3" Background="DarkGray" ResizeDirection="Columns"
                    IsVisible="{Binding RightPanViewModel, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Pestañas y no un solo panel: los formularios de un uso conviven con las
           herramientas que se quedan puestas, como los bloques de un juego de tiles. -->
      <TabControl Grid.Column="4"
                  ItemsSource="{Binding RightPanels}"
                  SelectedItem="{Binding RightPanViewModel}"
                  IsVisible="{Binding RightPanViewModel, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PanelBaseViewModel">
            <!-- Margen abajo: la linea que marca la pestaña seleccionada se alinea al
                 fondo de este bloque, no al de la pestaña, asi que sin aire se le queda
                 rozando el texto. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
              <Button Content="✕" FontSize="10" Padding="4,0" Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0"
                      Command="{Binding $parent[TabControl].((vm:MainWindowViewModel)DataContext).CloseRightPanelCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="Cerrar el panel" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>
    </Grid>

    <!-- Avalonia no tiene StatusBar; un Border con el texto hace el mismo papel. -->
    <Border Grid.Row="3" Background="Gainsboro" BorderBrush="DarkGray" BorderThickness="0,1,0,0" Padding="8,4">
      <TextBlock Text="MSX Game Editor V1.0" VerticalAlignment="Center" />
    </Border>

  </Grid>
</Window>
