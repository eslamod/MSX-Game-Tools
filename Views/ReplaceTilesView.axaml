<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="340"
             x:Class="MSX_GameTools.Views.ReplaceTilesView"
             x:DataType="vm:ReplaceTilesViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <UserControl.Styles>
    <!-- El marco del dibujo, para que un tile todo negro no se confunda con el fondo. -->
    <Style Selector="Border.tile">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#808080" />
      <Setter Property="Background" Value="#404040" />
    </Style>
  </UserControl.Styles>

  <!-- Los botones anclados abajo y el resto con barra: con la escala de la interfaz al
       200% el contenido mide el doble y los empujaba fuera del panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize ReplaceTitle}" FontWeight="Bold" Margin="0,0,0,10" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

    <!-- Los dos modos. El rango mueve un grupo entero de una vez; la lista es para
         cuando los tiles no van seguidos, que es lo normal en un dibujo. -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="12">
      <RadioButton GroupName="ReplaceMode" Content="{l:Localize ReplaceModeRange}"
                   IsChecked="{Binding IsRangeMode}" />
      <RadioButton GroupName="ReplaceMode" Content="{l:Localize ReplaceModeList}"
                   IsChecked="{Binding IsListMode}" />
    </StackPanel>

    <StackPanel IsVisible="{Binding IsRangeMode}">

    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize ReplaceFrom}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                     Minimum="0" Maximum="{Binding MaxTile}" Increment="1"
                     Value="{Binding FromFirst}" />
    </Grid>

    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize ReplaceTo}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                     Minimum="0" Maximum="{Binding MaxTile}" Increment="1"
                     Value="{Binding FromLast}"
                     ToolTip.Tip="{l:Localize ReplaceToTip}" />
    </Grid>

    <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{l:Localize ReplaceNew}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                     Minimum="0" Maximum="{Binding MaxTile}" Increment="1"
                     Value="{Binding ToFirst}"
                     ToolTip.Tip="{l:Localize ReplaceNewTip}" />
    </Grid>

    <TextBlock Text="{Binding RangeLabel}" TextWrapping="Wrap"
               Foreground="{DynamicResource AppTextSecondary}" Margin="0,4,0,8" />

    </StackPanel>

    <StackPanel IsVisible="{Binding IsListMode}">

      <!-- El dibujo al lado del numero: con 256 tiles nadie se acuerda de que es el 231,
           y aqui es donde se ve que te has equivocado, antes de tocar el mapa. -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
        <TextBlock Grid.Column="0" Text="{l:Localize ReplaceListAddFrom}"
                   VerticalAlignment="Center" Margin="0,0,6,0" />
        <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                       Minimum="0" Maximum="{Binding MaxTile}" Increment="1"
                       Value="{Binding NewFrom}" />
        <Border Grid.Column="2" Classes="tile" Margin="6,0,0,0">
          <Image Source="{Binding NewFromTile.SpritePreview}" Width="32" Height="32"
                 Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
        </Border>
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="{l:Localize ReplaceListAddTo}"
                   VerticalAlignment="Center" Margin="0,0,6,0" />
        <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                       Minimum="0" Maximum="{Binding MaxTile}" Increment="1"
                       Value="{Binding NewTo}" />
        <Border Grid.Column="2" Classes="tile" Margin="6,0,0,0">
          <Image Source="{Binding NewToTile.SpritePreview}" Width="32" Height="32"
                 Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
        </Border>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
        <Button Content="{l:Localize ReplaceAdd}" MinWidth="80"
                Command="{Binding AddSubstitutionCommand}" />
        <Button Content="{l:Localize ReplaceRemove}" MinWidth="80"
                Command="{Binding RemoveSubstitutionCommand}" />
      </StackPanel>

      <TextBlock Text="{l:Localize ReplaceAlreadyListed}" TextWrapping="Wrap"
                 Foreground="{DynamicResource AppTextError}" Margin="0,0,0,4"
                 IsVisible="{Binding AlreadyListed}" />

      <ListBox ItemsSource="{Binding Substitutions}"
               SelectedItem="{Binding SelectedSubstitution}"
               Height="200" Margin="0,0,0,8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TileSubstitution">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="tile">
                <Image Source="{Binding FromTile.SpritePreview}" Width="24" Height="24"
                       Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
              </Border>
              <TextBlock Text="{Binding From}" VerticalAlignment="Center" MinWidth="28"
                         TextAlignment="Right" />
              <TextBlock Text="→" VerticalAlignment="Center" />
              <Border Classes="tile">
                <Image Source="{Binding ToTile.SpritePreview}" Width="24" Height="24"
                       Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
              </Border>
              <TextBlock Text="{Binding To}" VerticalAlignment="Center" MinWidth="28"
                         TextAlignment="Right" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </StackPanel>

    <CheckBox Content="{l:Localize ReplaceAllLayers}" IsChecked="{Binding AllLayers}" />

    <CheckBox Content="{l:Localize ReplaceOnlySelection}"
              IsChecked="{Binding OnlySelection}"
              IsEnabled="{Binding HasSelection}" />

    <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap"
               Margin="0,10,0,0" FontWeight="Bold" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{l:Localize MapReplace}" MinWidth="90" Command="{Binding AcceptReplaceCommand}" />
      <Button Content="{l:Localize FormClose}" MinWidth="90" Margin="8,0,0,0" Command="{Binding CloseReplaceCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
