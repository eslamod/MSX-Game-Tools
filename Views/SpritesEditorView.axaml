<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:views="clr-namespace:MSX_GameTools.Views"
             xmlns:converters="clr-namespace:MSX_GameTools.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="MSX_GameTools.Views.SpritesEditorView"
             x:DataType="vm:SpritesEditorViewModel">

  <UserControl.Resources>
    <!-- Contenedor de cada miniatura: el recuadro cambia de color al pasar por
         encima y al seleccionar. El grosor no cambia nunca, para que el contenido
         no baile al pasar el raton. -->
    <ControlTheme x:Key="SpriteThumbnailItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Frame"
                  BorderBrush="Black"
                  BorderThickness="3"
                  Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Frame">
        <Setter Property="BorderBrush" Value="#FFC107" />
      </Style>

      <!-- Despues de :pointerover a proposito: si esta seleccionada y ademas
           tienes el raton encima, debe seguir viendose roja. -->
      <Style Selector="^:selected /template/ Border#PART_Frame">
        <Setter Property="BorderBrush" Value="Red" />
      </Style>
    </ControlTheme>

    <!-- Ojo de enseñar/ocultar. Dibujado y no un caracter: los emoji de ojo no estan
         en todas las fuentes y saldrian como un cuadrado. Apagado se atenua y se tacha,
         que a este tamaño se distingue mejor que un cambio de color. -->
    <ControlTheme x:Key="EyeToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root" Background="{TemplateBinding Background}">
            <Canvas Name="PART_Eye" Width="18" Height="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="M1,6 C4,1 14,1 17,6 C14,11 4,11 1,6 Z"
                    Stroke="#303030" StrokeThickness="1.2" />
              <Path Data="M9,3.6 A2.4,2.4 0 1,0 9,8.4 A2.4,2.4 0 1,0 9,3.6 Z"
                    Fill="#303030" />
              <Path Name="PART_Slash" Data="M1,11 L17,1"
                    Stroke="#B00000" StrokeThickness="1.6" IsVisible="False" />
            </Canvas>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="#FFE9A8" />
      </Style>

      <Style Selector="^:not(:checked) /template/ Canvas#PART_Eye">
        <Setter Property="Opacity" Value="0.45" />
      </Style>

      <Style Selector="^:not(:checked) /template/ Path#PART_Slash">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>

    <!-- Boton sin cromo, para que se vea solo la muestra de color. -->
    <ControlTheme x:Key="ColorSwatchButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#606060" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="#FFC107" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <!-- Columna 1: la tira de colores por linea, alineada con las filas del lienzo. -->
  <!-- La fila 0 es de alto fijo a proposito: si fuera Auto, los botones que solo
       aparecen en modo Grupos la harian crecer y desplazarian todo lo de abajo. -->
  <!-- La fila del lienzo es * y no el tamaño del zoom: asi nunca empuja la fila de
       navegacion fuera de la ventana, y si el lienzo no cabe sale su barra. -->
  <!-- La columna de la tira de colores es fija y no Auto: el ScrollViewer que abarca
       las dos primeras columnas inflaria la primera con el ancho de su contenido, y
       entonces las columnas sumarian mas que la rejilla y la barra de la derecha se
       saldria de la ventana. Ancho = la muestra de 52 mas sus margenes. -->
  <Grid x:Name="EditorGrid" Background="Gainsboro"
        ColumnDefinitions="256,64,*"
        RowDefinitions="32,*,Auto">

    <!-- Zoom del lienzo de edición y modo de pintado -->
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="2">
      <RadioButton GroupName="EditZoom" Theme="{StaticResource ToggleRadioButton}"
                   Content="X1" Tag="0" Width="32" Margin="2" IsChecked="True"
                   IsCheckedChanged="OnZoomChanged" />
      <RadioButton GroupName="EditZoom" Theme="{StaticResource ToggleRadioButton}"
                   Content="X2" Tag="1" Width="32" Margin="2"
                   IsCheckedChanged="OnZoomChanged" />
      <RadioButton GroupName="EditZoom" Theme="{StaticResource ToggleRadioButton}"
                   Content="X3" Tag="2" Width="32" Margin="2"
                   IsCheckedChanged="OnZoomChanged" />

      <Border Width="1" Background="DarkGray" Margin="6,4" />

      <RadioButton GroupName="PaintMode" Theme="{StaticResource ToggleRadioButton}"
                   Content="Punto" Tag="Click" Margin="2"
                   ToolTip.Tip="Cada clic pinta un solo pixel"
                   IsCheckedChanged="OnPaintModeChanged" />
      <RadioButton GroupName="PaintMode" Theme="{StaticResource ToggleRadioButton}"
                   Content="Trazo" Tag="Drag" Margin="2" IsChecked="True"
                   ToolTip.Tip="Mantén pulsado y arrastra para pintar todo el recorrido"
                   IsCheckedChanged="OnPaintModeChanged" />
    </StackPanel>

    <!-- Color de fondo: se ve donde el sprite no pinta, y en los pixeles cuyo
         color de linea sea el 0 (transparente). Comun a todo el banco. -->
    <Button x:Name="BackgroundSwatch"
            Grid.Row="0" Grid.Column="1"
            Theme="{StaticResource ColorSwatchButton}"
            Width="52" Height="22" Margin="4,2"
            HorizontalAlignment="Left" VerticalAlignment="Center"
            ToolTip.Tip="{Binding BackgroundColor.DisplayName, StringFormat='Fondo: {0}'}">
      <Grid ColumnDefinitions="*,Auto">
        <Border Grid.Column="0" Background="{Binding BackgroundColor.Brush}" />
        <TextBlock Grid.Column="1" Text="{Binding BackgroundColor.Hex}"
                   FontFamily="Consolas" FontSize="11" Width="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" />
      </Grid>
      <Button.Flyout>
        <Flyout Placement="Bottom">
          <ItemsControl ItemsSource="{Binding BackgroundChoices}" Width="152">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="entities:PaletteColor">
                <Button Theme="{StaticResource ColorSwatchButton}"
                        Width="34" Height="34" Margin="2"
                        ToolTip.Tip="{Binding DisplayName}"
                        Click="OnPaletteColorClick"
                        Command="{Binding $parent[ItemsControl].((vm:SpritesEditorViewModel)DataContext).PickBackgroundColorCommand}"
                        CommandParameter="{Binding}">
                  <Grid>
                    <Border Background="#DDDDDD" />
                    <Border Background="{Binding Brush}" />
                    <Border Background="#C0FFFFFF" Padding="2,0"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                      <TextBlock Text="{Binding Hex}" FontFamily="Consolas"
                                 FontSize="10" Foreground="Black" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Flyout>
      </Button.Flyout>
    </Button>

    <DockPanel Grid.Row="0" Grid.Column="2" Margin="2">

      <!-- Que enseña el panel: los patrones del banco o los grupos. -->
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <RadioButton x:Name="PatternsModeButton"
                     GroupName="ThumbnailMode" Theme="{StaticResource ToggleRadioButton}"
                     Content="Patrones" Tag="Patterns" Margin="2" IsChecked="True"
                     ToolTip.Tip="La tabla de patrones del banco"
                     IsCheckedChanged="OnThumbnailModeChanged" />
        <RadioButton x:Name="GroupsModeButton"
                     GroupName="ThumbnailMode" Theme="{StaticResource ToggleRadioButton}"
                     Content="Grupos" Tag="Groups" Margin="2"
                     ToolTip.Tip="Personajes compuestos con varios sprites superpuestos"
                     IsCheckedChanged="OnThumbnailModeChanged" />

        <Border Width="1" Background="DarkGray" Margin="6,4" IsVisible="{Binding ShowsGroups}" />

        <!-- Alto explicito para que igualen a los toggles y la fila no cambie. -->
        <Button Content="+" Width="28" Height="26" Padding="0" Margin="2"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                IsVisible="{Binding ShowsGroups}"
                Command="{Binding AddGroupCommand}"
                ToolTip.Tip="Crear un grupo con el sprite actual" />
        <Button Content="-" Width="28" Height="26" Padding="0" Margin="2"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                IsVisible="{Binding ShowsGroups}"
                Command="{Binding DeleteGroupCommand}"
                ToolTip.Tip="Eliminar el grupo seleccionado" />
      </StackPanel>

      <!-- Zoom de las miniaturas. El Tag es el multiplicador sobre el tamaño base. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <RadioButton GroupName="PreviewZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X1" Tag="1" Width="32" Margin="2" IsChecked="True"
                     IsCheckedChanged="OnThumbnailZoomChanged" />
        <RadioButton GroupName="PreviewZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X2" Tag="2" Width="32" Margin="2"
                     IsCheckedChanged="OnThumbnailZoomChanged" />
        <RadioButton GroupName="PreviewZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X3" Tag="3" Width="32" Margin="2"
                     IsCheckedChanged="OnThumbnailZoomChanged" />
        <RadioButton GroupName="PreviewZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X4" Tag="4" Width="32" Margin="2"
                     IsCheckedChanged="OnThumbnailZoomChanged" />
      </StackPanel>

      <Border />
    </DockPanel>

    <!-- Lienzo y tira de colores en el mismo ScrollViewer: si cada uno tuviera el
         suyo, al desplazar uno se desalinearia del otro. -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False">
      <StackPanel Orientation="Horizontal">

    <!-- Lienzo de edición 16x16 -->
    <Grid>

      <!-- La referencia va debajo del lienzo, centrada sobre los 16x16 y a la misma
           escala que un pixel del sprite: si se estirara al hueco dejaria de
           corresponderse con lo que se esta dibujando encima. Lo que la deja ver es la
           opacidad del lienzo, porque el lienzo pinta un rectangulo por pixel, tambien
           donde el sprite esta apagado. -->
      <Panel x:Name="CanvasBackground"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             IsVisible="{Binding PatternBackground.VisibleTile, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Panel.Width>
          <MultiBinding Converter="{x:Static converters:MultiplyConverter.Instance}">
            <Binding Path="CellSize" RelativeSource="{RelativeSource AncestorType=views:SpritesEditorView}" />
            <Binding Source="16" />
          </MultiBinding>
        </Panel.Width>
        <Panel.Height>
          <MultiBinding Converter="{x:Static converters:MultiplyConverter.Instance}">
            <Binding Path="CellSize" RelativeSource="{RelativeSource AncestorType=views:SpritesEditorView}" />
            <Binding Source="16" />
          </MultiBinding>
        </Panel.Height>

        <Image Source="{Binding PatternBackground.VisibleTile.Image}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="None">
          <Image.Width>
            <MultiBinding Converter="{x:Static converters:MultiplyConverter.Instance}">
              <Binding Path="PatternBackground.VisibleTile.PixelWidth" />
              <Binding Path="CellSize" RelativeSource="{RelativeSource AncestorType=views:SpritesEditorView}" />
            </MultiBinding>
          </Image.Width>
          <Image.Height>
            <MultiBinding Converter="{x:Static converters:MultiplyConverter.Instance}">
              <Binding Path="PatternBackground.VisibleTile.PixelHeight" />
              <Binding Path="CellSize" RelativeSource="{RelativeSource AncestorType=views:SpritesEditorView}" />
            </MultiBinding>
          </Image.Height>
        </Image>
      </Panel>

      <views:PixelCanvas x:Name="CanvSprite"
                         Surface="{Binding PixelSurface}"
                         Opacity="{Binding PatternOpacity}"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>


    <!-- MSX2: un color por linea, alineado con las filas del lienzo. -->
    <ItemsControl x:Name="RowColorStrip"
                  IsVisible="{Binding ShowsRowColors}"
                  ItemsSource="{Binding RowColors}"
                  VerticalAlignment="Top"
                  Margin="4,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SpriteRowColorViewModel">
          <Button Theme="{StaticResource ColorSwatchButton}"
                  Width="52"
                  Height="{Binding $parent[views:SpritesEditorView].CellSize}"
                  ToolTip.Tip="{Binding Color.DisplayName}">
            <Grid ColumnDefinitions="*,Auto">
              <Border Grid.Column="0" Background="{Binding Color.Brush}" />
              <TextBlock Grid.Column="1" Text="{Binding Color.Hex}"
                         FontFamily="Consolas" FontSize="11" Width="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="Right">
                <ItemsControl ItemsSource="{Binding Palette}" Width="152">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="entities:PaletteColor">
                      <Button Theme="{StaticResource ColorSwatchButton}"
                              Width="34" Height="34" Margin="2"
                              ToolTip.Tip="{Binding DisplayName}"
                              Click="OnPaletteColorClick"
                              Command="{Binding $parent[ItemsControl].((vm:SpriteRowColorViewModel)DataContext).PickCommand}"
                              CommandParameter="{Binding}">
                        <Grid>
                          <!-- El gris de debajo sólo se ve en el color 0, que es
                               transparente y si no quedaria invisible. -->
                          <Border Background="#DDDDDD" />
                          <Border Background="{Binding Brush}" />
                          <Border Background="#C0FFFFFF" Padding="2,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Hex}" FontFamily="Consolas"
                                       FontSize="10" Foreground="Black" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- MSX1: un unico color para todo el sprite. -->
    <StackPanel x:Name="SpriteColorPanel"
                IsVisible="{Binding ShowsSpriteColor}"
                VerticalAlignment="Top"
                Margin="4,0">
      <TextBlock Text="Color" FontSize="10" Margin="0,0,0,2" HorizontalAlignment="Center" />
      <Button Theme="{StaticResource ColorSwatchButton}"
              Width="52" Height="40"
              ToolTip.Tip="{Binding SpriteColor.DisplayName}">
        <Grid ColumnDefinitions="*,Auto">
          <Border Grid.Column="0" Background="{Binding SpriteColor.Brush}" />
          <TextBlock Grid.Column="1" Text="{Binding SpriteColor.Hex}"
                     FontFamily="Consolas" FontSize="11" Width="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" />
        </Grid>
        <Button.Flyout>
          <Flyout Placement="Right">
            <ItemsControl ItemsSource="{Binding Palette}" Width="152">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="entities:PaletteColor">
                  <Button Theme="{StaticResource ColorSwatchButton}"
                          Width="34" Height="34" Margin="2"
                          ToolTip.Tip="{Binding DisplayName}"
                          Click="OnPaletteColorClick"
                          Command="{Binding $parent[ItemsControl].((vm:SpritesEditorViewModel)DataContext).PickSpriteColorCommand}"
                          CommandParameter="{Binding}">
                    <Grid>
                      <Border Background="#DDDDDD" />
                      <Border Background="{Binding Brush}" />
                      <Border Background="#C0FFFFFF" Padding="2,0"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Hex}" FontFamily="Consolas"
                                   FontSize="10" Foreground="Black" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- El panel del grupo y la tira comparten la columna 2. Antes el panel estaba en
         la columna de colores, y al aparecer la ensanchaba de 60 a 252 px: eso movia
         200 px a la derecha todo lo que hubiera despues, incluida la barra de arriba. -->
    <DockPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">

    <!-- Panel del grupo seleccionado: sus miembros por orden de prioridad y los
         desplazamientos del que este seleccionado. -->
    <Border x:Name="GroupPanel"
            DockPanel.Dock="Left"
            IsVisible="{Binding ShowsGroups}"
            Width="252" Margin="0,0,4,0" Padding="6"
            Background="#F0F0F0" BorderBrush="DarkGray" BorderThickness="1">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
            IsEnabled="{Binding SelectedGroup, Converter={x:Static ObjectConverters.IsNotNull}}">

        <TextBlock Grid.Row="0" Text="Grupo" FontWeight="Bold" Margin="0,0,0,6" />

        <TextBox Grid.Row="1" Text="{Binding SelectedGroup.Group.Name}" Margin="0,0,0,8" />

        <ListBox Grid.Row="2"
                 x:Name="MemberList"
                 ItemsSource="{Binding SelectedGroup.Group.Members}"
                 SelectedItem="{Binding SelectedGroup.SelectedMember, Mode=TwoWay}"
                 SelectionMode="Single"
                 Height="84">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="entities:SpriteGroupMember">
              <Grid ColumnDefinitions="*,Auto">
                <!-- Separadores explicitos: sin ellos "Patrón 0 x 0 y 0" se lee como si
                     la x formara parte del numero anterior. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" TextElement.FontFamily="Consolas">
                  <TextBlock Text="{Binding PatternIndex, StringFormat='Patrón {0}'}" />
                  <TextBlock Text=" ; " Foreground="#909090" />
                  <TextBlock Text="{Binding OffsetX, StringFormat='x:{0}'}" />
                  <TextBlock Text=" ; " Foreground="#909090" />
                  <TextBlock Text="{Binding OffsetY, StringFormat='y:{0}'}" />
                </StackPanel>

                <ToggleButton Grid.Column="1"
                              Theme="{StaticResource EyeToggle}"
                              IsChecked="{Binding IsVisible}"
                              ToolTip.Tip="Enseñar u ocultar este plano en la composición" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- El orden de la lista es la prioridad: el primero manda. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
          <Button Content="+" Width="30" HorizontalContentAlignment="Center"
                  Command="{Binding SelectedGroup.AddMemberCommand}"
                  ToolTip.Tip="Añadir un sprite con el mismo patrón" />
          <Button Content="-" Width="30" HorizontalContentAlignment="Center"
                  Command="{Binding SelectedGroup.RemoveMemberCommand}"
                  ToolTip.Tip="Quitar el sprite seleccionado" />
          <Button Content="▲" Width="30" HorizontalContentAlignment="Center"
                  Command="{Binding SelectedGroup.MoveMemberUpCommand}"
                  ToolTip.Tip="Subir en prioridad" />
          <Button Content="▼" Width="30" HorizontalContentAlignment="Center"
                  Command="{Binding SelectedGroup.MoveMemberDownCommand}"
                  ToolTip.Tip="Bajar en prioridad" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,10,0,0" Spacing="4"
                    IsEnabled="{Binding SelectedGroup.SelectedMember, Converter={x:Static ObjectConverters.IsNotNull}}">

          <Grid ColumnDefinitions="56,28,*,28">
            <TextBlock Grid.Column="0" Text="Patrón" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="◄" HorizontalContentAlignment="Center"
                    Command="{Binding SelectedGroup.StepPatternCommand}" CommandParameter="-1" />
            <TextBlock Grid.Column="2" Text="{Binding SelectedGroup.SelectedMember.PatternIndex}"
                       FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="►" HorizontalContentAlignment="Center"
                    Command="{Binding SelectedGroup.StepPatternCommand}" CommandParameter="1" />
          </Grid>

          <Grid ColumnDefinitions="56,28,*,28">
            <TextBlock Grid.Column="0" Text="Offset X" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="◄" HorizontalContentAlignment="Center"
                    Command="{Binding SelectedGroup.NudgeOffsetCommand}" CommandParameter="left" />
            <TextBlock Grid.Column="2" Text="{Binding SelectedGroup.SelectedMember.OffsetX}"
                       FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="►" HorizontalContentAlignment="Center"
                    Command="{Binding SelectedGroup.NudgeOffsetCommand}" CommandParameter="right" />
          </Grid>

          <Grid ColumnDefinitions="56,28,*,28">
            <TextBlock Grid.Column="0" Text="Offset Y" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="▲" HorizontalContentAlignment="Center"
                    Command="{Binding SelectedGroup.NudgeOffsetCommand}" CommandParameter="up" />
            <TextBlock Grid.Column="2" Text="{Binding SelectedGroup.SelectedMember.OffsetY}"
                       FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="▼" HorizontalContentAlignment="Center"
                    Command="{Binding SelectedGroup.NudgeOffsetCommand}" CommandParameter="down" />
          </Grid>

          <!-- Fondo del grupo. Es del grupo, no del miembro seleccionado: la referencia
               es la escena contra la que se coloca la composicion entera. Sin ninguna
               imagen cargada no se enseña nada. -->
          <StackPanel IsVisible="{Binding HasBackgrounds}" Margin="0,10,0,0">
            <TextBlock Text="Fondo" FontWeight="Bold" Margin="0,0,0,4" />

            <Grid ColumnDefinitions="*,Auto,Auto">
              <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Backgrounds.Images}"
                        SelectedItem="{Binding SelectedGroup.Background.Image}"
                        PlaceholderText="Sin fondo"
                        ToolTip.Tip="Imagen de referencia detrás de la composición">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="entities:ReferenceImage">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Button Grid.Column="1"
                      Content="{Binding SelectedGroup.Background.CellLabel}"
                      MinWidth="52" Margin="4,0,0,0" FontFamily="Consolas"
                      HorizontalContentAlignment="Center"
                      IsVisible="{Binding SelectedGroup.Background.CanPickCell}"
                      Command="{Binding SelectedGroup.Background.PickCellCommand}"
                      ToolTip.Tip="Elegir la celda de la hoja" />

              <ToggleButton Grid.Column="2" Content="Ver"
                            MinWidth="40" Margin="4,0,0,0"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding SelectedGroup.Background.HasTile}"
                            IsChecked="{Binding SelectedGroup.Background.IsVisible}"
                            ToolTip.Tip="Enseñar u ocultar la referencia" />
            </Grid>

            <Grid ColumnDefinitions="56,*" Margin="0,4,0,0">
              <TextBlock Grid.Column="0" Text="Opacidad" VerticalAlignment="Center" FontSize="11" />
              <Slider Grid.Column="1"
                      Minimum="0.15" Maximum="1"
                      Value="{Binding SelectedGroup.SpriteOpacity}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Opacidad de los sprites sobre la referencia" />
            </Grid>
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,12,0,4">
          <TextBlock Grid.Column="0" Text="Colores" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Del patrón" FontSize="10" Padding="6,2"
                  Command="{Binding SelectedGroup.RestoreColorsCommand}"
                  ToolTip.Tip="Volver a sembrar los colores desde el patrón del miembro" />
        </Grid>

        <!-- MSX2: un color y un CC por linea del miembro. Son los colores del miembro,
             no los del patron: el patron solo fue la plantilla de la que se sembraron. -->
        <ScrollViewer Grid.Row="6"
                      IsVisible="{Binding SelectedGroup.IsMsx2}"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="MemberColorList" ItemsSource="{Binding SelectedGroup.MemberColors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SpriteMemberColorViewModel">
                <Grid ColumnDefinitions="16,*,Auto" Height="22" Margin="0,1">
                  <TextBlock Grid.Column="0" Text="{Binding Hex}"
                             FontFamily="Consolas" FontSize="11"
                             VerticalAlignment="Center" Foreground="#606060" />

                  <Button Grid.Column="1" Theme="{StaticResource ColorSwatchButton}"
                          Margin="2,0" ToolTip.Tip="{Binding Color.DisplayName}">
                    <Grid ColumnDefinitions="*,Auto">
                      <Border Grid.Column="0" Background="{Binding Color.Brush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Color.Hex}"
                                 FontFamily="Consolas" FontSize="11" Width="16"
                                 TextAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Button.Flyout>
                      <Flyout Placement="Left">
                        <ItemsControl ItemsSource="{Binding Palette}" Width="152">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:PaletteColor">
                              <Button Theme="{StaticResource ColorSwatchButton}"
                                      Width="34" Height="34" Margin="2"
                                      ToolTip.Tip="{Binding DisplayName}"
                                      Click="OnPaletteColorClick"
                                      Command="{Binding $parent[ItemsControl].((vm:SpriteMemberColorViewModel)DataContext).PickCommand}"
                                      CommandParameter="{Binding}">
                                <Grid>
                                  <Border Background="#DDDDDD" />
                                  <Border Background="{Binding Brush}" />
                                  <Border Background="#C0FFFFFF" Padding="2,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Hex}" FontFamily="Consolas"
                                               FontSize="10" Foreground="Black" />
                                  </Border>
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Flyout>
                    </Button.Flyout>
                  </Button>

                  <!-- CC: combina el color de esta linea con el sprite de mayor prioridad. -->
                  <ToggleButton Grid.Column="2" Content="OR" Width="34" FontSize="10"
                                Padding="0" HorizontalContentAlignment="Center"
                                IsChecked="{Binding Row.CombineColor, Mode=TwoWay}"
                                ToolTip.Tip="CC: combinar con OR el color de esta línea con el del sprite de mayor prioridad" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- MSX1: un unico color para todo el sprite del miembro. -->
        <StackPanel Grid.Row="6" IsVisible="{Binding SelectedGroup.IsMsx1}" VerticalAlignment="Top">
          <Button x:Name="MemberColorSwatch"
                  Theme="{StaticResource ColorSwatchButton}" Height="34"
                  ToolTip.Tip="{Binding SelectedGroup.MemberColor.DisplayName}">
            <Grid ColumnDefinitions="*,Auto">
              <Border Grid.Column="0" Background="{Binding SelectedGroup.MemberColor.Brush}" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedGroup.MemberColor.Hex}"
                         FontFamily="Consolas" FontSize="11" Width="16"
                         TextAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="Left">
                <ItemsControl ItemsSource="{Binding SelectedGroup.Palette}" Width="152">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="entities:PaletteColor">
                      <Button Theme="{StaticResource ColorSwatchButton}"
                              Width="34" Height="34" Margin="2"
                              ToolTip.Tip="{Binding DisplayName}"
                              Click="OnPaletteColorClick"
                              Command="{Binding $parent[ItemsControl].((vm:SpritesEditorViewModel)DataContext).SelectedGroup.PickMemberColorCommand}"
                              CommandParameter="{Binding}">
                        <Grid>
                          <Border Background="#DDDDDD" />
                          <Border Background="{Binding Brush}" />
                          <Border Background="#C0FFFFFF" Padding="2,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Hex}" FontFamily="Consolas"
                                       FontSize="10" Foreground="Black" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Miniaturas del banco. ListBox y no ItemsControl: la seleccion, el hover y
         la navegacion por teclado vienen de serie, y SelectedItem enlazado en dos
         sentidos mantiene sincronizados el lienzo de edicion y esta tira. -->
    <Border Background="DarkGray">
      <Panel>
      <ListBox x:Name="ThumbnailList"
               ScrollViewer.AllowAutoHide="False"
               IsVisible="{Binding ShowsPatterns}"
               ItemsSource="{Binding ImagesMiniList}"
               SelectedItem="{Binding SelectedThumbnail, Mode=TwoWay}"
               SelectionMode="Single"
               ItemContainerTheme="{StaticResource SpriteThumbnailItem}"
               Background="Transparent"
               BorderThickness="0"
               Padding="4">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="entities:ImageMini">
            <!-- El tamaño vive en la vista, no en el ViewModel: es presentacion pura.
                 BitmapInterpolationMode="None" = escalado nearest neighbour,
                 imprescindible para que un sprite de 16x16 no salga borroso. -->
            <Image Source="{Binding SpritePreview}"
                   Width="{Binding $parent[views:SpritesEditorView].ThumbnailSize}"
                   Height="{Binding $parent[views:SpritesEditorView].ThumbnailSize}"
                   Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="None" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Los grupos, cada uno con sus sprites ya compuestos. El lienzo es de 46x46
           fijo, no del tamaño que resulte de los offsets, para que la tira no se
           reordene entera cada vez que se toca una flecha. -->
      <ListBox x:Name="GroupList"
               ScrollViewer.AllowAutoHide="False"
               IsVisible="{Binding ShowsGroups}"
               ItemsSource="{Binding Groups}"
               SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
               SelectionMode="Single"
               ItemContainerTheme="{StaticResource SpriteThumbnailItem}"
               Background="Transparent"
               BorderThickness="0"
               Padding="4">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SpriteGroupViewModel">
            <StackPanel>
              <!-- Tres capas: el color de fondo del banco, la referencia encima y la
                   composicion arriba del todo. La composicion se dibuja con el hueco
                   transparente cuando hay referencia, asi que basta con superponerlas,
                   y la referencia va centrada y a escala de pixel de sprite, no
                   estirada al hueco.

                   El color de fondo hace falta porque el lienzo del grupo es de 46x46
                   (16 del sprite mas 15 de margen a cada lado) y una celda de 16 solo
                   cubre el centro: sin esta capa por los bordes se veria el gris del
                   panel de detras, que no es un color del banco ni significa nada. -->
              <Panel Width="{Binding $parent[views:SpritesEditorView].GroupThumbnailSize}"
                     Height="{Binding $parent[views:SpritesEditorView].GroupThumbnailSize}">
                <Border Background="{Binding $parent[views:SpritesEditorView].((vm:SpritesEditorViewModel)DataContext).BackgroundColor.Brush}"
                        IsVisible="{Binding Background.VisibleTile, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <Image Source="{Binding Background.VisibleTile.Image}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="None">
                  <Image.Width>
                    <MultiBinding Converter="{x:Static converters:MultiplyConverter.Instance}">
                      <Binding Path="Background.VisibleTile.PixelWidth" />
                      <Binding Path="GroupPixelSize" RelativeSource="{RelativeSource AncestorType=views:SpritesEditorView}" />
                    </MultiBinding>
                  </Image.Width>
                  <Image.Height>
                    <MultiBinding Converter="{x:Static converters:MultiplyConverter.Instance}">
                      <Binding Path="Background.VisibleTile.PixelHeight" />
                      <Binding Path="GroupPixelSize" RelativeSource="{RelativeSource AncestorType=views:SpritesEditorView}" />
                    </MultiBinding>
                  </Image.Height>
                </Image>

                <Image Source="{Binding Preview.SpritePreview}"
                       Opacity="{Binding SpriteOpacity}"
                       Stretch="Fill"
                       RenderOptions.BitmapInterpolationMode="None" />
              </Panel>
              <TextBlock Text="{Binding Group.Name}" FontSize="10"
                         HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </Panel>
    </Border>
    </DockPanel>

    <!-- Navegación por los sprites del banco -->
    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal"
                Background="Gainsboro" Height="48" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
        <TextBlock Text="{Binding CurrentSpritePosition}" VerticalAlignment="Center" />
        <TextBlock Text=" / " VerticalAlignment="Center" />
        <TextBlock Text="{Binding NumberSprites}" VerticalAlignment="Center" />
      </StackPanel>
      <Button Width="44" Content="&lt;" FontSize="20" Margin="3"
              HorizontalContentAlignment="Center"
              Command="{Binding PreviousSpriteCommand}" />
      <Button Width="44" Content="&gt;" FontSize="20" Margin="3"
              HorizontalContentAlignment="Center"
              Command="{Binding NextSpriteCommand}" />
      <Button Width="44" Content="+" FontSize="20" Margin="3"
              HorizontalContentAlignment="Center"
              Command="{Binding AddSpriteCommand}" />
      <Button Width="44" Content="X" FontSize="20" Margin="3" Foreground="Red"
              HorizontalContentAlignment="Center"
              Command="{Binding DeleteSpriteCommand}" />
    </StackPanel>

    <!-- Fondo del patrón que se está dibujando. Se elige aquí y no en el panel del
       grupo porque son dos preguntas distintas: qué escena hay detrás de una
       composición, y qué dibujo estoy calcando en este sprite. -->
    <!-- Mismo reparto que el panel del grupo: los tres controles en una fila y la
       opacidad debajo. En una sola fila no caben en los 256 de la columna, y encima
       la columna se estrecha o se ensancha con el zoom del lienzo. -->
    <StackPanel Grid.Row="2" Grid.Column="0"
              VerticalAlignment="Top" Margin="6,54,6,0"
              IsVisible="{Binding HasBackgrounds}">

    <TextBlock Text="Fondo" FontWeight="Bold" Margin="0,0,0,4" />

    <Grid ColumnDefinitions="*,Auto,Auto">
      <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" FontSize="11"
                ItemsSource="{Binding Backgrounds.Images}"
                SelectedItem="{Binding PatternBackground.Image}"
                PlaceholderText="Sin fondo"
                ToolTip.Tip="Imagen de referencia detrás del lienzo">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="entities:ReferenceImage">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!-- La celda se elige aqui y no en el desplegable: volver a elegir en un ComboBox
           lo que ya estaba elegido no dispara nada, asi que sin este boton no habria
           forma de cambiar de celda sin cambiar antes de imagen. -->
      <Button Grid.Column="1"
              Content="{Binding PatternBackground.CellLabel}"
              MinWidth="52" Margin="4,0,0,0" FontFamily="Consolas" FontSize="11"
              HorizontalContentAlignment="Center"
              IsVisible="{Binding PatternBackground.CanPickCell}"
              Command="{Binding PatternBackground.PickCellCommand}"
              ToolTip.Tip="Elegir la celda de la hoja" />

      <!-- Ocultar sin olvidar: "Sin fondo" borra la celda elegida, y para volver a
           ponerla habria que acordarse de cual era. -->
      <ToggleButton Grid.Column="2" Content="Ver"
                    MinWidth="40" Margin="4,0,0,0" FontSize="11"
                    HorizontalContentAlignment="Center"
                    IsVisible="{Binding PatternBackground.HasTile}"
                    IsChecked="{Binding PatternBackground.IsVisible}"
                    ToolTip.Tip="Enseñar u ocultar la referencia" />
    </Grid>

    <Grid ColumnDefinitions="56,*" Margin="0,4,0,0">
      <TextBlock Grid.Column="0" Text="Opacidad" VerticalAlignment="Center" FontSize="11" />
      <Slider Grid.Column="1"
              Minimum="0.15" Maximum="1"
              Value="{Binding PatternOpacity}"
              VerticalAlignment="Center"
              ToolTip.Tip="Opacidad del sprite sobre la referencia" />
    </Grid>
    </StackPanel>

  </Grid>
</UserControl>
