<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:MSX_GameTools.Localization"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="180"
        x:Class="MSX_GameTools.Views.ConfirmationWindow"
        Title="Confirmar"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto" MinWidth="340">
    <TextBlock x:Name="HeadingText" Grid.Row="0" FontWeight="Bold" Margin="0,0,0,8" />

    <!-- Con tope de alto y su scroll: el mensaje lo pone quien abre el dialogo, y al salir
         con muchos documentos sin guardar es una linea por documento. La ventana se ajusta a
         su contenido, asi que sin tope crecia hasta pasarse de la pantalla y los botones
         quedaban fuera, sin manera de contestar ni de cancelar. -->
    <ScrollViewer Grid.Row="1" MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="380" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
      <!-- MinWidth y no Width: el texto lo pone quien abre el dialogo y cambia con el
           idioma, asi que un ancho fijo lo recorta. «Guardar y salir» ya no cabia. -->
      <Button x:Name="AlternativeButton" MinWidth="120" IsVisible="False"
              HorizontalContentAlignment="Center"
              Click="OnAlternative" />
      <Button x:Name="ConfirmButton" MinWidth="100"
              HorizontalContentAlignment="Center"
              Click="OnConfirm" />
      <Button x:Name="CancelButton" Content="{l:Localize FormCancel}" MinWidth="100"
              HorizontalContentAlignment="Center"
              IsCancel="True" IsDefault="True"
              Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
