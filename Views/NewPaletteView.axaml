<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="240"
             x:Class="MSX_GameTools.Views.NewPaletteView"
             x:DataType="vm:NewPaletteViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <!-- Titulo arriba, botones abajo y lo de en medio con barra, como el resto de los
       formularios: al crecer, las filas Auto empujaban los botones fuera del panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize NewPaletteTitle}" FontWeight="Bold" Margin="0,0,0,10" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="{l:Localize FormName}" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Name}" />
        </Grid>

        <!-- De cual se copia. Los 16 colores de partida son medio trabajo hecho, y la que
             quieres de base rara vez es la que resulta que estabas mirando. -->
        <Grid ColumnDefinitions="70,*" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="{l:Localize NewPaletteFrom}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Sources}"
                    SelectedItem="{Binding Source}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="entities:ColorPalette">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <TextBlock Text="{l:Localize NewPaletteFromTip}" Foreground="{DynamicResource AppTextSecondary}"
                   TextWrapping="Wrap" Margin="70,0,0,6" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppTextError}"
                   TextWrapping="Wrap" VerticalAlignment="Top"
                   IsVisible="{Binding HasError}" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" MinWidth="90" Command="{Binding AcceptPaletteCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelPaletteCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
