<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="MSX_GameTools.Views.EditPaletteView"
             x:DataType="vm:EditPaletteViewModel"
             DragDrop.AllowDrop="True"
             Background="{DynamicResource AppPanelBackground}">

  <UserControl.Resources>
    <!-- El alto de una fila y su borde, en un solo sitio. Las dos columnas -la paleta que
         se edita y la que se compara- tienen que ir al mismo paso, y con el numero escrito
         en cada una se descuadraban un poco por fila: al llegar abajo, la diferencia era de
         media lista. -->
    <x:Double x:Key="PaletteRowHeight">24</x:Double>
    <Thickness x:Key="PaletteRowBorder">2</Thickness>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Las filas de la lista, apretadas. El ListBoxItem de serie trae relleno y alto
         minimo pensados para texto suelto, y con dieciseis colores eso son dos pantallas
         de lista para algo que se lee de un vistazo. -->
    <Style Selector="ListBox#ColorList > ListBoxItem">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="BorderThickness" Value="{StaticResource PaletteRowBorder}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- La pista de arrastrar, apagada mientras el ratón no esté en la lista. -->
    <Style Selector="TextBlock#SwapHint">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="TextBlock#SwapHint.hovering">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- La entrada sobre la que se va a soltar el color que se arrastra. El borde va
         puesto siempre y transparente: si apareciera al marcar, la fila cambiaria de alto
         al pasar el raton por encima y la lista entera daria un salto. -->
    <Style Selector="ListBox#ColorList > ListBoxItem.drop">
      <Setter Property="BorderBrush" Value="{DynamicResource AppDropTarget}" />
    </Style>
  </UserControl.Styles>

  <!-- Una sola barra para todo el contenido, con el boton de cerrar anclado abajo. La
       lista de colores no lleva la suya: dentro de la barra de fuera crece hasta los 16 y
       dos barras anidadas son peores que una. Con la escala al 200% el boton se iba por
       debajo del borde y no habia forma de cerrar el panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize PaletteTitle}" FontWeight="Bold" Margin="0,0,0,10" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <!-- Hueco a la derecha para la barra: se dibuja encima del contenido, y sin esto
           tapaba los numeros de R, G y B, que van pegados al borde. Los dieciseis que mide
           la barra agarrada no bastan: dejaban el numero justo a ras. -->
      <StackPanel Margin="0,0,22,0">

    <Grid ColumnDefinitions="72,*" Margin="0,0,0,10">
      <TextBlock Grid.Column="0" Text="{l:Localize FormName}" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Palette.Name}" />
    </Grid>

    <!-- Con que paleta se compara. Va aqui y no en un panel aparte porque comparar sirve
         para mover colores hasta que dos paletas se parezcan, y mover colores es lo que hace
         este panel: en uno aparte habria que ir y volver a cada arrastre. -->
    <Grid ColumnDefinitions="72,*,Auto" Margin="0,0,0,10">
      <TextBlock Grid.Column="0" Text="{l:Localize PaletteCompare}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Comparisons}"
                SelectedItem="{Binding Compared}"
                PlaceholderText="{l:Localize PaletteCompareNone}"
                ToolTip.Tip="{l:Localize PaletteCompareTip}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="entities:ColorPalette">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2" Content="X" Margin="4,0,0,0" Padding="8,0"
              Command="{Binding StopComparingCommand}"
              IsVisible="{Binding IsComparing}"
              ToolTip.Tip="{l:Localize PaletteCompareClear}" />
    </Grid>

    <!-- Los 16 colores, y a la derecha los de la paleta con la que se compara. Emparejados
         por indice, que es como se compara de verdad: lo que se quiere saber es que hay en
         el 4 aqui y que hay en el 4 alli, porque eso decide que mover. -->
    <Grid ColumnDefinitions="*,Auto">

    <ListBox x:Name="ColorList" Grid.Column="0"
             ItemsSource="{Binding Palette.Colors}"
             SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
             SelectionMode="Single"
             DragDrop.AllowDrop="True"
             ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="entities:PaletteColor">
          <Grid ColumnDefinitions="Auto,28,*,Auto" Height="{StaticResource PaletteRowHeight}">
            <Border Grid.Column="0" Width="24" Height="18"
                    BorderBrush="Black" BorderThickness="1"
                    VerticalAlignment="Center">
              <Grid>
                <!-- El gris de debajo sólo se ve en el color 0, que es transparente. -->
                <Border Background="#DDDDDD" />
                <Border Background="{Binding Brush}" />
              </Grid>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Hex}"
                       FontFamily="{StaticResource CodeFont}" VerticalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding HexRgb}"
                       FontFamily="{StaticResource CodeFont}" Foreground="{DynamicResource AppTextSecondary}"
                       VerticalAlignment="Center" Margin="6,0,0,0"
                       ToolTip.Tip="{l:Localize PaletteComponentsTip}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ItemsControl Grid.Column="1" ItemsSource="{Binding ComparedColors}"
                  IsVisible="{Binding IsComparing}" Margin="6,0,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComparedColor">
          <!-- Mismo alto y mismo borde que las filas de la izquierda, y de los mismos recursos:
               las dos columnas van emparejadas por indice, asi que basta con que una fila mida
               un pelo distinto para que abajo esten a media fila de diferencia. -->
          <Border BorderThickness="{StaticResource PaletteRowBorder}" BorderBrush="Transparent">
          <Grid ColumnDefinitions="Auto,Auto,Auto" Height="{StaticResource PaletteRowHeight}">
            <Border Grid.Column="0" Width="24" Height="18"
                    BorderBrush="Black" BorderThickness="1"
                    VerticalAlignment="Center">
              <Grid>
                <Border Background="#DDDDDD" />
                <Border Background="{Binding Brush}" />
              </Grid>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Hex}"
                       FontFamily="{StaticResource CodeFont}" Foreground="{DynamicResource AppTextSecondary}"
                       VerticalAlignment="Center" Margin="4,0,0,0" />
            <!-- La marca de los que ya coinciden: los que no la llevan son los que quedan. -->
            <TextBlock Grid.Column="2" Text="=" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="4,0,0,0"
                       IsVisible="{Binding Same}"
                       ToolTip.Tip="{l:Localize PaletteCompareSame}" />
          </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    </Grid>

    <!-- La pista de arrastrar, fija y debajo de la lista, encendiéndose al entrar en ella.
         De globo no valía: colgado de la lista se abría una sola vez donde estuviera el
         ratón y se quedaba ahí, señalando a una fila que ya no era; y colgado de cada fila
         perseguía al ratón lista abajo, que cansa.

         Se apaga con la opacidad y no con IsVisible: así el texto ocupa su sitio siempre y
         lo de debajo no pega un salto cada vez que el ratón entra o sale de la lista. -->
    <TextBlock x:Name="SwapHint" Text="{l:Localize PaletteSwapTip}"
               Classes.hovering="{Binding #ColorList.IsPointerOver}"
               Foreground="{DynamicResource AppTextSecondary}"
               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

    <!-- Componentes del color seleccionado, en el formato nativo del MSX: 0-7. -->
    <StackPanel Margin="0,10,0,0"
                IsEnabled="{Binding SelectedColor.IsEditable}">

      <TextBlock Text="{l:Localize PaletteTransparent}"
                 IsVisible="{Binding SelectedColor.IsTransparent}"
                 Foreground="{DynamicResource AppTextError}" TextWrapping="Wrap" Margin="0,0,0,6" />

      <Grid ColumnDefinitions="20,*" Margin="0,2,0,6">
        <TextBlock Grid.Column="0" Text="N" VerticalAlignment="Center"
                   ToolTip.Tip="{l:Localize PaletteColorNameTip}" />
        <TextBox Grid.Column="1" Text="{Binding SelectedColor.Name}"
                 PlaceholderText="{l:Localize BlocksNoName}" />
      </Grid>

      <Grid ColumnDefinitions="20,*,24" Margin="0,2">
        <TextBlock Grid.Column="0" Text="R" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="0" Maximum="7"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding SelectedColor.Red}" />
        <TextBlock Grid.Column="2" Text="{Binding SelectedColor.Red}"
                   FontFamily="{StaticResource CodeFont}" VerticalAlignment="Center" TextAlignment="Right" />
      </Grid>

      <Grid ColumnDefinitions="20,*,24" Margin="0,2">
        <TextBlock Grid.Column="0" Text="G" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="0" Maximum="7"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding SelectedColor.Green}" />
        <TextBlock Grid.Column="2" Text="{Binding SelectedColor.Green}"
                   FontFamily="{StaticResource CodeFont}" VerticalAlignment="Center" TextAlignment="Right" />
      </Grid>

      <Grid ColumnDefinitions="20,*,24" Margin="0,2">
        <TextBlock Grid.Column="0" Text="B" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="0" Maximum="7"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding SelectedColor.Blue}" />
        <TextBlock Grid.Column="2" Text="{Binding SelectedColor.Blue}"
                   FontFamily="{StaticResource CodeFont}" VerticalAlignment="Center" TextAlignment="Right" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
        <Border Grid.Column="0" Width="48" Height="24"
                BorderBrush="Black" BorderThickness="1"
                Background="{Binding SelectedColor.Brush}" />
        <TextBlock Grid.Column="1" Text="{Binding SelectedColor.HexRgb}"
                   FontFamily="{StaticResource CodeFont}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
    </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Aplicar sólo sale cuando hay colores movidos de sitio: mientras no los haya no
         hay nada que ajustar, y un botón apagado ahí sin explicación sólo distrae. -->
    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
      <Button Content="{l:Localize PaletteApply}" MinWidth="85"
              IsVisible="{Binding HasSwaps}"
              Command="{Binding ApplyCommand}" />
      <!-- Y deshacer sólo con un ajuste ya aplicado: antes no hay nada que deshacer, y con
           movimientos pendientes el botón que toca es el de aplicar. -->
      <Button Content="{l:Localize PaletteUndoApply}" MinWidth="85"
              IsVisible="{Binding CanUndoApplied}"
              Command="{Binding UndoAppliedCommand}" />
      <Button Content="{l:Localize FormClose}" MinWidth="85"
              Command="{Binding CloseCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
