<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="600"
             x:Class="MSX_GameTools.Views.ImportSpriteSheetView"
             x:DataType="vm:ImportSpriteSheetViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <UserControl.Resources>
    <!-- Lo mas alto que se le consiente a la hoja antes de que se desplace dentro de su
         recuadro. Sin tope, una hoja larga deja los controles y el informe a tres pantallas
         de distancia y hay que bajar a ciegas para ver si lo elegido cabe. -->
    <x:Double x:Key="SheetPreviewMaxHeight">360</x:Double>
  </UserControl.Resources>

  <!-- El titulo arriba, los botones abajo y todo lo demas con barra, como el resto de los
       formularios: con la escala de la interfaz al doble, cualquier fila fija de en medio
       empuja los botones fuera del panel y deja sin forma de aceptar ni de cancelar. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize ImportSheetTitle}" FontWeight="Bold" Margin="0,0,0,10" />

    <!-- Este solo se desplaza en vertical. Con barra horizontal, el contenido recibiria ancho
         infinito y los textos no envolverian nunca: el informe salia en una sola linea larguisima
         con su propia barra. Lo que necesita desplazarse a lo ancho es la hoja, y esa lleva la
         suya. -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False">
      <StackPanel>

    <!-- La hoja a su tamaño con la reticula encima. Sin encogerla: reducida no se acertaria
         la celda, y para eso esta la barra. Con tope de alto para que una hoja larga no deje
         los controles a tres pantallas de distancia. -->
    <ScrollViewer MaxHeight="{StaticResource SheetPreviewMaxHeight}"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False">
      <Panel x:Name="SheetPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
             Background="{DynamicResource AppCanvasFrame}">
        <Image x:Name="SheetImage" Stretch="Fill"
               RenderOptions.BitmapInterpolationMode="None"
               Source="{Binding Source}" />

        <!-- La capa que recibe el raton. Transparente y no nula: con Background nulo un Canvas
             no recibe pulsaciones, y el arrastre no llegaria a empezar. -->
        <Canvas x:Name="CellOverlay" Background="Transparent"
                PointerPressed="OnSheetPressed"
                PointerMoved="OnSheetMoved"
                PointerReleased="OnSheetReleased" />
      </Panel>
    </ScrollViewer>

    <StackPanel Margin="0,10,0,0">

      <TextBlock Text="{l:Localize ImportSheetHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                 Foreground="{DynamicResource AppTextSecondary}" />

      <!-- Los dos modos comparten casi todo el formulario, asi que es un interruptor y no otra
           entrada de menu. Lo que cambia es que en el de patrones no hay color: un pixel esta
           o no esta, y los controles de color sobran. -->
      <CheckBox Content="{l:Localize ImportSheetOnlyPatterns}" IsChecked="{Binding OnlyPatterns}"
                Margin="0,0,0,8" />

      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,8">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Localize ImportSheetCell}"
                   VerticalAlignment="Center" Margin="0,0,8,4" />
        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                  ItemsSource="{Binding CellSizes}" SelectedItem="{Binding CellSize}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Localize ImportSheetPlanes}"
                   VerticalAlignment="Center" Margin="0,0,8,4"
                   IsVisible="{Binding IsCombined}" />
        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                  IsVisible="{Binding IsCombined}"
                  ItemsSource="{Binding PlaneChoices}" SelectedItem="{Binding MaxPlanes}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Localize ImportSheetTransparent}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />

        <!-- Los colores de la hoja, del mas usado al menos. El primero sale elegido porque
             casi siempre es el fondo, asi que la mayoria de hojas no hay ni que tocarlas. -->
        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding SheetColors}" SelectedItem="{Binding Transparent}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SheetColor">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="18" Height="14" Background="{Binding Brush}"
                        BorderThickness="1" BorderBrush="{DynamicResource AppSeparator}" />
                <TextBlock Text="{Binding Hex}" FontFamily="Consolas" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <!-- Lo que costaria, rehecho con cada cambio. Es lo que hace que se pueda ajustar el
           rectangulo sabiendo si entra, en vez de descubrirlo al final. -->
      <Border Background="{DynamicResource AppSurfaceBackground}"
              BorderBrush="{DynamicResource AppSeparator}" BorderThickness="1"
              Padding="8" Margin="0,0,0,8">
        <TextBlock Text="{Binding Report}" TextWrapping="Wrap" />
      </Border>

    </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="6" Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" Command="{Binding AcceptCommand}" />
      <Button Content="{l:Localize FormCancel}" Command="{Binding CancelCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
