<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             xmlns:views="clr-namespace:MSX_GameTools.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="MSX_GameTools.Views.TileSetEditorView"
             x:DataType="vm:TileSetEditorViewModel">

  <UserControl.Styles>
    <!-- El mismo tamaño y el mismo aire que en el editor de mapas: son la misma barra
         partida en dos vistas, y si no coinciden se nota al cambiar de pestaña.
         Aqui va con :is() porque la rejilla es un ToggleButton, y el selector de tipo
         de Avalonia no alcanza a los derivados. -->
    <Style Selector=":is(Button).tool">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style Selector=":is(Button).tool > icons|MaterialIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>

    <Style Selector="icons|MaterialIcon.mode">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  </UserControl.Styles>

  <UserControl.Resources>
    <!-- Las miniaturas van pegadas, sin margen: la rejilla la forman sus propios
         bordes, como la de GIMP. El grosor no cambia al seleccionar para que los
         tiles no bailen. -->
    <ControlTheme x:Key="TileThumbnailItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <!-- El recuadro va superpuesto y no envolviendo: un borde alrededor ocuparia
               sitio y separaria los tiles, que es justo lo que no se quiere. -->
          <Panel>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <Border Name="PART_Frame" BorderThickness="1" BorderBrush="Transparent"
                    IsHitTestVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Frame">
        <Setter Property="BorderBrush" Value="#FFC107" />
      </Style>

      <Style Selector="^:selected /template/ Border#PART_Frame">
        <Setter Property="BorderBrush" Value="Red" />
      </Style>
    </ControlTheme>

  </UserControl.Resources>

  <!-- La fila del lienzo es * y no el tamaño del zoom: asi nunca empuja la fila de
       navegacion fuera de la ventana, y si el lienzo no cabe sale su barra. -->
  <!-- La columna de la tira de colores es fija y no Auto: el ScrollViewer que abarca
       las dos primeras columnas inflaria la primera con el ancho de su contenido, y
       entonces las columnas sumarian mas que la rejilla y la barra de la derecha se
       saldria de la ventana. Ancho = las dos muestras de 44 mas sus margenes. -->
  <!-- La fila de atributos va entre el lienzo y la navegacion, y en Auto: si no hay
       ninguno definido no ocupa nada y el lienzo se queda con todo el alto, que es como
       estaba antes de que existieran. -->
  <Grid x:Name="EditorGrid" Background="{DynamicResource AppPanelBackground}"
        ColumnDefinitions="256,100,*"
        RowDefinitions="32,*,Auto,Auto">

    <!-- Zoom del lienzo, modo de pintado y rejilla -->
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="2">
      <RadioButton GroupName="TileZoom" Theme="{StaticResource ToggleRadioButton}"
                   Content="X1" Tag="0" MinWidth="34" Margin="2" IsChecked="True"
                   IsCheckedChanged="OnZoomChanged" />
      <RadioButton GroupName="TileZoom" Theme="{StaticResource ToggleRadioButton}"
                   Content="X2" Tag="1" MinWidth="34" Margin="2"
                   IsCheckedChanged="OnZoomChanged" />
      <RadioButton GroupName="TileZoom" Theme="{StaticResource ToggleRadioButton}"
                   Content="X3" Tag="2" MinWidth="34" Margin="2"
                   IsCheckedChanged="OnZoomChanged" />

      <Border Classes="separator" />

      <!-- Estos dos se quedan sin icono, y no por gusto: esta columna mide 256 fijos y
           con icono la tira pedia 273. Entre quitarles el rotulo o quitarles el icono,
           se va el icono: son un modo, y en un modo el rotulo es lo que dice donde
           estas. La comprobacion que lo midio sigue puesta. -->
      <RadioButton GroupName="TilePaintMode" Theme="{StaticResource ToggleRadioButton}"
                   Content="{l:Localize PaintDot}" Tag="Click" Margin="2"
                   ToolTip.Tip="{l:Localize PaintDotTip}"
                   IsCheckedChanged="OnPaintModeChanged" />
      <RadioButton GroupName="TilePaintMode" Theme="{StaticResource ToggleRadioButton}"
                   Content="{l:Localize PaintStroke}" Tag="Drag" Margin="2" IsChecked="True"
                   ToolTip.Tip="{l:Localize PaintStrokeTip}"
                   IsCheckedChanged="OnPaintModeChanged" />
    </StackPanel>

    <!-- Lienzo y tira de colores en el mismo ScrollViewer: si cada uno tuviera el
         suyo, al desplazar uno se desalinearia del otro. -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False">
      <StackPanel Orientation="Horizontal">

    <Grid>
      <views:PixelCanvas x:Name="CanvTile"
                         Surface="{Binding PixelSurface}"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>

    <!-- Los dos colores de cada línea, alineados con las filas del lienzo. En un tile
         un pixel es el color de frente o el de fondo de su línea, nunca otro. -->
    <ItemsControl x:Name="RowColorStrip"
                  ItemsSource="{Binding RowColors}"
                  VerticalAlignment="Top" Margin="4,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TileRowColorViewModel">
          <Grid ColumnDefinitions="Auto,Auto"
                Height="{Binding $parent[views:TileSetEditorView].CellSize}">
            <Button Grid.Column="0" Theme="{StaticResource TileColorSwatch}" Width="44"
                    ToolTip.Tip="{Binding Foreground.DisplayName, StringFormat='Frente: {0}'}">
              <!-- En el menu del boton derecho y no en un boton de la barra: no cambia
                   nada de lo que se ve, asi que quien no lo necesite no tiene por que
                   tropezarse con el. Esta en los dos colores porque la operacion es de
                   la linea y da igual por cual se entre. -->
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{l:Localize TileSwapRowColors}"
                            Command="{Binding SwapColorsCommand}" />
                </ContextMenu>
              </Button.ContextMenu>
              <Grid ColumnDefinitions="*,Auto">
                <Border Grid.Column="0" Background="{Binding Foreground.Brush}" />
                <TextBlock Grid.Column="1" Text="{Binding Foreground.Hex}"
                           FontFamily="Consolas" FontSize="11" Width="16"
                           TextAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <Button.Flyout>
                <Flyout Placement="Right">
                  <ItemsControl ItemsSource="{Binding Palette}" Width="152">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="entities:PaletteColor">
                        <Button Theme="{StaticResource TileColorSwatch}"
                                Width="34" Height="34" Margin="2"
                                ToolTip.Tip="{Binding DisplayName}"
                                Click="OnPaletteColorClick"
                                Command="{Binding $parent[ItemsControl].((vm:TileRowColorViewModel)DataContext).PickForegroundCommand}"
                                CommandParameter="{Binding}">
                          <Border Background="{Binding Brush}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Button Grid.Column="1" Theme="{StaticResource TileColorSwatch}" Width="44" Margin="2,0,0,0"
                    ToolTip.Tip="{Binding Background.DisplayName, StringFormat='Fondo: {0}'}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{l:Localize TileSwapRowColors}"
                            Command="{Binding SwapColorsCommand}" />
                </ContextMenu>
              </Button.ContextMenu>
              <Grid ColumnDefinitions="*,Auto">
                <Border Grid.Column="0" Background="{Binding Background.Brush}" />
                <TextBlock Grid.Column="1" Text="{Binding Background.Hex}"
                           FontFamily="Consolas" FontSize="11" Width="16"
                           TextAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <Button.Flyout>
                <Flyout Placement="Right">
                  <ItemsControl ItemsSource="{Binding Palette}" Width="152">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="entities:PaletteColor">
                        <Button Theme="{StaticResource TileColorSwatch}"
                                Width="34" Height="34" Margin="2"
                                ToolTip.Tip="{Binding DisplayName}"
                                Click="OnPaletteColorClick"
                                Command="{Binding $parent[ItemsControl].((vm:TileRowColorViewModel)DataContext).PickBackgroundCommand}"
                                CommandParameter="{Binding}">
                          <Border Background="{Binding Brush}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <!-- Los atributos del tile que se esta editando, pegados al lienzo y no en el panel de
         la derecha: cambian con cada tile que se elige y se quieren ver mientras se dibuja,
         y ese panel es para formularios de un uso. Aqui debajo habia sitio vacio.

         El bloque entero desaparece si el juego no define ninguno, que es la premisa: quien
         no los use no tiene que enterarse de que existen. -->
    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="6,10,6,4" IsVisible="{Binding HasAttributes}">

      <TextBlock Text="{l:Localize TileAttributesOfTile}" FontWeight="Bold" Margin="0,0,0,6" />

      <ItemsControl ItemsSource="{Binding TileAttributes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TileFlagViewModel">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}"
                      MinHeight="0" Padding="6,0,0,0" Margin="0,0,0,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

    <!-- Zoom de las miniaturas y rejilla -->
    <DockPanel Grid.Row="0" Grid.Column="2" Margin="2">
      <!-- El zoom va declarado primero a proposito: en un DockPanel el hijo que se declara
           antes se queda con el ancho que pide, asi que con la barra delante estos botones
           acababan fuera de la ventana en cuanto la barra crecio. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <RadioButton GroupName="TilePreviewZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X1" Tag="1" MinWidth="34" Margin="2" IsChecked="True"
                     IsCheckedChanged="OnThumbnailZoomChanged" />
        <RadioButton GroupName="TilePreviewZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X2" Tag="2" MinWidth="34" Margin="2"
                     IsCheckedChanged="OnThumbnailZoomChanged" />
        <RadioButton GroupName="TilePreviewZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X3" Tag="3" MinWidth="34" Margin="2"
                     IsCheckedChanged="OnThumbnailZoomChanged" />
        <RadioButton GroupName="TilePreviewZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X4" Tag="4" MinWidth="34" Margin="2"
                     IsCheckedChanged="OnThumbnailZoomChanged" />
      </StackPanel>

      <!-- Y en WrapPanel y no en fila: con los tres modos y el deshacer, a 900 px esta
           barra no cabe de una pieza. Se parte en dos lineas en vez de dejar controles
           inalcanzables. Va la ultima, que es la que ocupa lo que sobra. -->
      <WrapPanel Orientation="Horizontal">

        <!-- Color del borde: es lo que se ve donde un tile usa el codigo 0, que en
             GRAPHIC 2 es transparente. Sin esto el editor enseñaba el 0 como un color
             mas y la maquina mostraba otra cosa. -->
        <TextBlock Text="{l:Localize TilesBorder}" VerticalAlignment="Center" Margin="4,0,4,0" />
        <Button x:Name="BorderSwatch"
                Theme="{StaticResource TileColorSwatch}"
                Width="52" Height="22" Margin="0,2,8,2"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding BorderColor.DisplayName, StringFormat='Borde: {0}'}">
          <Grid ColumnDefinitions="*,Auto">
            <Border Grid.Column="0" Background="{Binding BorderColor.Brush}" />
            <TextBlock Grid.Column="1" Text="{Binding BorderColor.Hex}"
                       FontFamily="Consolas" FontSize="11" Width="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" />
          </Grid>
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <ItemsControl ItemsSource="{Binding BorderChoices}" Width="152">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="entities:PaletteColor">
                    <Button Theme="{StaticResource TileColorSwatch}"
                            Width="34" Height="34" Margin="2"
                            ToolTip.Tip="{Binding DisplayName}"
                            Click="OnPaletteColorClick"
                            Command="{Binding $parent[ItemsControl].((vm:TileSetEditorViewModel)DataContext).PickBorderColorCommand}"
                            CommandParameter="{Binding}">
                      <Border Background="{Binding Brush}" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>

        <ToggleButton Classes="tool"
                      IsChecked="{Binding $parent[views:TileSetEditorView].ShowGrid}"
                      ToolTip.Tip="{l:Localize TilesGridTip}">
          <icons:MaterialIcon Kind="Grid" />
        </ToggleButton>

        <!-- Los mismos tres modos y los mismos nombres que el editor de mapas, para no
             tener que aprender dos vocabularios. Van aqui, encima de la rejilla, porque
             es sobre ella donde actuan; el lienzo de la izquierda sigue igual. -->
        <Border Classes="separator" />

        <RadioButton x:Name="EditTool" GroupName="TileTool" Theme="{StaticResource ToggleRadioButton}"
                     Tag="Edit" Margin="2" Padding="8,2"
                     IsChecked="{Binding IsEditTool, Mode=OneWay}"
                     ToolTip.Tip="{l:Localize TileToolEditTip}"
                     IsCheckedChanged="OnToolChanged">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:MaterialIcon Kind="Pencil" Classes="mode" />
            <TextBlock Text="{l:Localize TileToolEdit}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="SelectTool" GroupName="TileTool" Theme="{StaticResource ToggleRadioButton}"
                     Tag="Select" Margin="2" Padding="8,2"
                     IsChecked="{Binding IsSelectTool, Mode=OneWay}"
                     ToolTip.Tip="{l:Localize TileToolSelectTip}"
                     IsCheckedChanged="OnToolChanged">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:MaterialIcon Kind="SelectionDrag" Classes="mode" />
            <TextBlock Text="{l:Localize TileToolSelect}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="StampTool" GroupName="TileTool" Theme="{StaticResource ToggleRadioButton}"
                     Tag="Stamp" Margin="2" Padding="8,2"
                     IsChecked="{Binding IsStampTool, Mode=OneWay}"
                     ToolTip.Tip="{l:Localize TileToolStampTip}"
                     IsCheckedChanged="OnToolChanged">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:MaterialIcon Kind="Stamper" Classes="mode" />
            <TextBlock Text="{l:Localize TileToolStamp}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>

        <Button Classes="tool" Margin="8,1,1,1"
                Command="{Binding UndoStampCommand}"
                ToolTip.Tip="{l:Localize TileUndoStampTip}">
          <icons:MaterialIcon Kind="Undo" />
        </Button>
      </WrapPanel>

    </DockPanel>

    <!-- Los 256 tiles, 32 de ancho por 8 de alto y todos juntos -->
    <!-- Sin alineacion a Left/Top a proposito: con ellas el Border se dimensiona al
         contenido, el ScrollViewer de dentro nunca recibe un limite y no aparece
         ninguna barra por mucho que la rejilla se salga de la pantalla. -->
    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="2"
            Background="Gray" Margin="0,0,4,4" Padding="4">
      <!-- AllowAutoHide a false: por defecto Avalonia deja una linea fina y solo saca la
             barra al pasar el raton por encima, asi que no se ve que hay mas contenido. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      AllowAutoHide="False">
        <!-- Alineado a Left/Top: dentro de un ScrollViewer eso hace que la lista se
             dimensione a su contenido en vez de estirarse al hueco. Si se estira, el
             UniformGrid reparte el ancho disponible entre sus 32 columnas y los tiles
             dejan de ser cuadrados. La alineacion va aqui y no en el Border de fuera,
             que ese tiene que ocupar el hueco para que el ScrollViewer tenga limite. -->
        <!-- La rejilla y encima una capa transparente que sólo recibe el ratón en los
             modos de marcar y estampar. Asi el ListBox sigue funcionando igual para
             elegir el tile que se edita, y no hay que reescribirlo como lienzo. -->
        <Grid x:Name="GridArea" HorizontalAlignment="Left" VerticalAlignment="Top">

        <ListBox x:Name="TileGrid"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 ItemsSource="{Binding Thumbnails}"
                 SelectedItem="{Binding SelectedThumbnail, Mode=TwoWay}"
                 SelectionMode="Single"
                 ItemContainerTheme="{StaticResource TileThumbnailItem}"
                 Background="Transparent"
                 BorderThickness="{Binding $parent[views:TileSetEditorView].GridEdgeThickness}"
                 BorderBrush="{Binding $parent[views:TileSetEditorView].GridBrush}"
                 Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="32" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="entities:ImageMini">
              <!-- El borde de cada tile es la rejilla: los tiles van pegados, asi que
                   sus bordes forman las lineas, como la rejilla de GIMP. -->
              <Border BorderThickness="{Binding $parent[views:TileSetEditorView].GridThickness}"
                      BorderBrush="{Binding $parent[views:TileSetEditorView].GridBrush}">
                <Image Source="{Binding SpritePreview}"
                       Width="{Binding $parent[views:TileSetEditorView].ThumbnailSize}"
                       Height="{Binding $parent[views:TileSetEditorView].ThumbnailSize}"
                       Stretch="Fill"
                       RenderOptions.BitmapInterpolationMode="None" />
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Canvas x:Name="ToolLayer" Background="Transparent"
                IsVisible="{Binding !IsEditTool}"
                PointerPressed="OnToolLayerPressed"
                PointerMoved="OnToolLayerMoved"
                PointerReleased="OnToolLayerReleased"
                PointerExited="OnToolLayerExited">

          <!-- Lo que se va a soltar, translucido y bajo el raton. Se ve donde va a caer
               antes de tocar nada, que es lo que evita el estampado en el sitio de al
               lado. -->
          <ItemsControl x:Name="StampGhost" IsVisible="False" Opacity="0.55">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid x:Name="GhostGrid" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="entities:ImageMini">
                <Image Source="{Binding SpritePreview}"
                       Width="{Binding $parent[views:TileSetEditorView].ThumbnailSize}"
                       Height="{Binding $parent[views:TileSetEditorView].ThumbnailSize}"
                       Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border x:Name="SelectionMark" IsVisible="False" IsHitTestVisible="False"
                  BorderThickness="2" BorderBrush="Red" Background="#33FF0000" />
        </Canvas>

        </Grid>
      </ScrollViewer>
    </Border>

    <!-- Navegación por los tiles -->
    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal"
                Background="{DynamicResource AppPanelBackground}" Height="48" VerticalAlignment="Top">
      <!-- Los cuatro son el mismo boton que los de las barras de arriba: mismo tamaño,
           mismo icono y mismo aire. Antes estos eran mas grandes -36 de ancho y el icono a
           20- porque estaban sueltos, y con veinte de icono en treinta y seis de boton el
           dibujo se comia el hueco y se veia mas grande que lo que lo rodeaba. Ya no estan
           sueltos: son cuatro en fila. -->
      <StackPanel x:Name="TileNavStrip"
                  Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
        <TextBlock Text="{Binding TileLabel}" VerticalAlignment="Center"
                   FontFamily="Consolas" MinWidth="64" Margin="0,0,8,0" />
        <Button Classes="tool"
                Command="{Binding PreviousTileCommand}"
                ToolTip.Tip="{l:Localize TilePreviousTip}">
          <icons:MaterialIcon Kind="ChevronLeft" />
        </Button>
        <Button Classes="tool"
                Command="{Binding NextTileCommand}"
                ToolTip.Tip="{l:Localize TileNextTip}">
          <icons:MaterialIcon Kind="ChevronRight" />
        </Button>

        <!-- Las dos puertas: los bloques y las propiedades del juego. Las dos se abren
             tambien desde el arbol, pero eso no lo descubre nadie, y las propiedades son
             donde se definen los atributos.

             Solo icono, y no por gusto: con rotulo la tira acababa en 387 y hasta la
             rejilla de tiles hay 356, asi que se le metia encima. Entre quitar una puerta o
             quitar los rotulos se van los rotulos, que el problema era justamente que estas
             dos no se encontraban. Se apoyan en la ayuda emergente, como el resto. -->
        <Border Classes="separator" />

        <Button Classes="tool"
                Click="OnShowBlocks"
                ToolTip.Tip="{l:Localize BlocksOpenTip}">
          <icons:MaterialIcon Kind="ViewGridOutline" />
        </Button>
        <Button Classes="tool"
                Click="OnShowProperties"
                ToolTip.Tip="{l:Localize PropertiesOpenTip}">
          <icons:MaterialIcon Kind="Tune" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
