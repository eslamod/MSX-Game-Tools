<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="MSX_GameTools.Views.EditTileSetView"
             x:DataType="vm:EditTileSetViewModel"
             Background="Gainsboro">

  <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize NewTileSetTitle}" FontWeight="Bold" Margin="0,0,0,12" />

    <Grid Grid.Row="1" ColumnDefinitions="60,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{l:Localize FormName}" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="{l:Localize NewTileSetHint}" />
    </Grid>

    <!-- Con que colores se dibuja. Se pregunta aqui porque la paleta va dentro del
         fichero del juego: es suya, no un ajuste del programa. -->
    <Grid Grid.Row="2" ColumnDefinitions="60,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{l:Localize FormPalette}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Palettes}"
                SelectedItem="{Binding Palette}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="entities:ColorPalette">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- No hay tipo que elegir: el formato de un tile es el mismo en GRAPHIC 2 y 3, y
         lo unico que cambia en MSX2 es que los 16 colores se pueden redefinir, que ya
         lo lleva la paleta de aqui arriba. -->
    <TextBlock Grid.Row="3" Text="{l:Localize NewTileSetNote}"
               Foreground="#606060" TextWrapping="Wrap" />

    <TextBlock Grid.Row="4"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Foreground="Firebrick"
               TextWrapping="Wrap"
               Margin="0,10,0,0" />

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
      <Button Content="{l:Localize FormAccept}" MinWidth="85" Command="{Binding AcceptTileSetCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="85" Command="{Binding CancelTileSetCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
