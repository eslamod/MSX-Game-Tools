<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="MSX_GameTools.Views.EditTileSetView"
             x:DataType="vm:EditTileSetViewModel"
             Background="Gainsboro">

  <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="New tileset" FontWeight="Bold" Margin="0,0,0,12" />

    <Grid Grid.Row="1" ColumnDefinitions="46,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="Tileset 1" />
    </Grid>

    <!-- No hay tipo que elegir: el formato de un tile es el mismo en GRAPHIC 2 y 3, y
         lo unico que cambia en MSX2 es que los 16 colores se pueden redefinir, que ya
         lo lleva la paleta activa. -->
    <TextBlock Grid.Row="2" Text="256 tiles de 8x8, vacios."
               Foreground="#606060" TextWrapping="Wrap" />

    <TextBlock Grid.Row="3"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Foreground="Firebrick"
               TextWrapping="Wrap"
               Margin="0,10,0,0" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
      <Button Content="Accept" Width="75" Command="{Binding AcceptTileSetCommand}" />
      <Button Content="Cancel" Width="75" Command="{Binding CancelTileSetCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
