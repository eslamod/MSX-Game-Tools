<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="MSX_GameTools.Views.EditTileSetView"
             x:DataType="vm:EditTileSetViewModel"
             Background="{DynamicResource AppPanelBackground}">

  <!-- El titulo arriba, los botones abajo y lo de en medio con barra: al crecer el
       formulario, las filas Auto empujaban a Aceptar y Cancelar fuera del panel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{l:Localize NewTileSetTitle}" FontWeight="Bold" Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

    <Grid ColumnDefinitions="60,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{l:Localize FormName}" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="{l:Localize NewTileSetHint}" />
    </Grid>

    <!-- Con que colores se dibuja. Se pregunta aqui porque la paleta va dentro del
         fichero del juego: es suya, no un ajuste del programa. -->
    <Grid ColumnDefinitions="60,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{l:Localize FormPalette}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Palettes}"
                SelectedItem="{Binding Palette}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="entities:ColorPalette">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- No hay tipo que elegir: el formato de un tile es el mismo en GRAPHIC 2 y 3, y
         lo unico que cambia en MSX2 es que los 16 colores se pueden redefinir, que ya
         lo lleva la paleta de aqui arriba. -->
    <StackPanel>

      <TextBlock Text="{l:Localize NewTileSetNote}" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" />

      <!-- Se pregunta aqui y no al crear el mapa: el tamaño del supertile es del juego,
           porque un supertile es un bloque con el tamaño clavado y los bloques cuelgan
           del juego. Por mapa, dos mapas del mismo juego podrian pedir tamaños distintos
           y la regla de los bloques no se podria cumplir para los dos. -->
      <CheckBox Content="{l:Localize NewTileSetSuperTiles}" Margin="0,10,0,0"
                IsChecked="{Binding UseSuperTiles}" />

      <StackPanel Margin="24,0,0,0" IsEnabled="{Binding UseSuperTiles}">
        <Grid ColumnDefinitions="60,*" Margin="0,4,0,4">
          <TextBlock Grid.Column="0" Text="{l:Localize NewTileSetSuperWidth}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                         Minimum="1" Maximum="{Binding MaxSuperTileSide}" Increment="1"
                         Value="{Binding SuperTileWidth}" />
        </Grid>

        <Grid ColumnDefinitions="60,*" Margin="0,0,0,4">
          <TextBlock Grid.Column="0" Text="{l:Localize NewTileSetSuperHeight}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" ShowButtonSpinner="True" FormatString="0"
                         Minimum="1" Maximum="{Binding MaxSuperTileSide}" Increment="1"
                         Value="{Binding SuperTileHeight}" />
        </Grid>

        <TextBlock Text="{l:Localize NewTileSetSuperTilesNote}"
                   Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" />
      </StackPanel>

    </StackPanel>

    <TextBlock Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Foreground="{DynamicResource AppTextError}"
               TextWrapping="Wrap"
               Margin="0,10,0,0" />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"
                Margin="0,10,0,0">
      <Button Content="{l:Localize FormAccept}" MinWidth="85" Command="{Binding AcceptTileSetCommand}" />
      <Button Content="{l:Localize FormCancel}" MinWidth="85" Command="{Binding CancelTileSetCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
