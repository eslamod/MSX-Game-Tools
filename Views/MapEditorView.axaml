<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:MSX_GameTools.Entities"
             xmlns:vm="clr-namespace:MSX_GameTools.ViewModels"
             xmlns:l="clr-namespace:MSX_GameTools.Localization"
             xmlns:views="clr-namespace:MSX_GameTools.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MSX_GameTools.Views.MapEditorView"
             x:DataType="vm:MapEditorViewModel">

  <UserControl.Styles>
    <!-- Los botones de accion de la barra: cuadrados y del mismo tamaño, que es lo que
         hace que una tira de iconos se lea como una tira y no como cosas sueltas. -->
    <!-- Margen 2 y no 1: entre dos botones el hueco es la suma de los dos margenes que se
         tocan, asi que esto son 4, que es lo que separa las tiras del editor de tiles.
         Esta barra iba a 2 y al lado de la otra se veia apretada. -->
    <Style Selector="Button.tool">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style Selector="Button.tool > icons|MaterialIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>

    <!-- Los de modo van un pelin mas pequeños: acompañan al texto, no lo sustituyen. -->
    <Style Selector="icons|MaterialIcon.mode">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.choice">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Margin" Value="3" />
    </Style>

    <Style Selector="Border.choice.selected">
      <Setter Property="BorderBrush" Value="Red" />
    </Style>

    <Style Selector="Border.mark">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.mark.selected">
      <Setter Property="BorderBrush" Value="Red" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,3,220">

    <!-- Barra de herramientas. Las tres primeras son modos y por eso son RadioButton:
         sólo una manda a la vez. Lo demás son acciones sobre lo que haya. -->
    <DockPanel Grid.Row="0" Background="{DynamicResource AppPanelBackground}">

      <!-- Los modos llevan icono y texto: es en cual estas metido, y el rotulo refuerza el
           estado. Las acciones sueltas van solo con icono, apoyadas en la ayuda emergente
           que ya tenian. -->
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="4,3">
        <RadioButton GroupName="MapTool" Theme="{StaticResource ToggleRadioButton}"
                     Tag="Stamp" Margin="2" IsChecked="True"
                     IsCheckedChanged="OnToolChanged"
                     ToolTip.Tip="{l:Localize MapStampTip}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:MaterialIcon Kind="Stamper" Classes="mode" />
            <TextBlock Text="{l:Localize MapStamp}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="MapTool" Theme="{StaticResource ToggleRadioButton}"
                     Tag="Select" Margin="2"
                     IsCheckedChanged="OnToolChanged"
                     ToolTip.Tip="{l:Localize MapSelectTip}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:MaterialIcon Kind="SelectionDrag" Classes="mode" />
            <TextBlock Text="{l:Localize MapSelect}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="MapTool" Theme="{StaticResource ToggleRadioButton}"
                     Tag="Pan" Margin="2"
                     IsCheckedChanged="OnToolChanged"
                     ToolTip.Tip="{l:Localize MapPanTip}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:MaterialIcon Kind="CursorMove" Classes="mode" />
            <TextBlock Text="{l:Localize MapPan}" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>

        <Border Width="1" Background="{DynamicResource AppSeparator}" Margin="6,2" />

        <Button Classes="tool" Command="{Binding FillSelectionCommand}"
                ToolTip.Tip="{l:Localize MapFillTip}">
          <icons:MaterialIcon Kind="FormatColorFill" />
        </Button>
        <Button Classes="tool" Command="{Binding CopySelectionCommand}"
                ToolTip.Tip="{l:Localize MapCopyTip}">
          <icons:MaterialIcon Kind="ContentCopy" />
        </Button>
        <Button Classes="tool" Command="{Binding EraseSelectionCommand}"
                ToolTip.Tip="{l:Localize MapClearTip}">
          <icons:MaterialIcon Kind="Eraser" />
        </Button>
        <Button Classes="tool" Click="OnReplaceTiles"
                ToolTip.Tip="{l:Localize MapReplaceTip}">
          <icons:MaterialIcon Kind="FindReplace" />
        </Button>

        <Border Width="1" Background="{DynamicResource AppSeparator}" Margin="6,2" />

        <Button Classes="tool" Command="{Binding UndoCommand}"
                ToolTip.Tip="{l:Localize MapUndoTip}">
          <icons:MaterialIcon Kind="Undo" />
        </Button>
        <Button Classes="tool" Command="{Binding RedoCommand}"
                ToolTip.Tip="{l:Localize MapRedoTip}">
          <icons:MaterialIcon Kind="Redo" />
        </Button>

        <Border Width="1" Background="{DynamicResource AppSeparator}" Margin="6,2" />

        <Button Classes="tool" Command="{Binding ZoomOutCommand}"
                ToolTip.Tip="{l:Localize MapZoomOutTip}">
          <icons:MaterialIcon Kind="MagnifyMinusOutline" />
        </Button>
        <Button Classes="tool" Command="{Binding ZoomInCommand}"
                ToolTip.Tip="{l:Localize MapZoomInTip}">
          <icons:MaterialIcon Kind="MagnifyPlusOutline" />
        </Button>
        <Button Classes="tool" Click="OnFitZoom"
                ToolTip.Tip="{l:Localize MapFitTip}">
          <icons:MaterialIcon Kind="FitToPageOutline" />
        </Button>
      </StackPanel>

      <!-- Lo que se lee mientras se trabaja: dónde está el ratón, el zoom y lo cogido. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,3"
                  VerticalAlignment="Center">
        <TextBlock Text="{Binding HoverLabel}" FontFamily="Consolas" MinWidth="60"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding ZoomLabel}" Margin="10,0" MinWidth="28"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding BrushLabel}" FontWeight="Bold" Margin="6,0"
                   VerticalAlignment="Center" />
      </StackPanel>

      <Border />
    </DockPanel>

    <!-- Mapa a la izquierda, capas y atributos a la derecha -->
    <Grid Grid.Row="1" ColumnDefinitions="*,3,250">

      <!-- Las imagenes son los tiles del juego o los supertiles ya compuestos, segun de
           que vaya el mapa; el lienzo dibuja una por celda sin saber cual es cual. Lo
           unico que le hace falta es cuanto mide la celda. -->
      <views:MapCanvas x:Name="Canvas" Grid.Column="0"
                       Map="{Binding Map}"
                       Tiles="{Binding CellImages}"
                       CellTilesWidth="{Binding CellTilesWidth}"
                       CellTilesHeight="{Binding CellTilesHeight}"
                       Zoom="{Binding Zoom}"
                       Background="{Binding BackgroundBrush}"
                       Brush="{Binding Brush}"
                       Selection="{Binding Selection}"
                       Tool="{Binding Tool}" />

      <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource AppSeparator}" ResizeDirection="Columns" />

      <Grid Grid.Column="2" Background="{DynamicResource AppPanelBackground}" RowDefinitions="Auto,*,Auto,Auto"
            Margin="4">

        <!-- Capas -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="+" Width="26" HorizontalContentAlignment="Center"
                    Command="{Binding AddLayerCommand}" ToolTip.Tip="{l:Localize MapAddLayerTip}" />
            <Button Content="-" Width="26" Margin="3,0,0,0" HorizontalContentAlignment="Center"
                    Command="{Binding DeleteLayerCommand}" ToolTip.Tip="{l:Localize MapDeleteLayerTip}" />
          </StackPanel>
          <TextBlock Text="{l:Localize MapLayers}" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>

        <ListBox Grid.Row="1" Background="{DynamicResource AppListBackground}"
                 ItemsSource="{Binding Layers}"
                 SelectedItem="{Binding ActiveLayer}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MapLayerViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding Name}" BorderThickness="0"
                         Background="Transparent" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Content="👁" Padding="4,0" FontSize="11"
                              IsChecked="{Binding IsVisible}"
                              ToolTip.Tip="{l:Localize MapLayerVisibleTip}" />
                <ToggleButton Grid.Column="2" Content="🔒" Padding="4,0" FontSize="11" Margin="2,0,0,0"
                              IsChecked="{Binding IsLocked}"
                              ToolTip.Tip="{l:Localize MapLayerLockedTip}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Atributos del mapa -->
        <TextBlock Grid.Row="2" Text="{l:Localize MapTitle}" FontWeight="Bold" Margin="0,8,0,4" />

        <Grid Grid.Row="3" ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Localize FormName}" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Map.Name}" Margin="0,0,0,4" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Localize MapSize}" VerticalAlignment="Center" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{Binding Map.Width}" VerticalAlignment="Center" />
            <TextBlock Text=" x " VerticalAlignment="Center" />
            <TextBlock Text="{Binding Map.Height}" VerticalAlignment="Center" />
            <!-- Redimensionar es un botón y no editar el número: la operación descoloca
                 el mapa entero y no puede dispararse al teclear un dígito. -->
            <Button Content="{l:Localize MapResize}" Margin="8,0,0,0" Padding="6,1" FontSize="11"
                    Click="OnResize"
                    ToolTip.Tip="{l:Localize MapResizeTip}" />
          </StackPanel>

          <!-- El fondo se puede cambiar, no solo mirar: es el mismo R#7 del borde del
               editor de tiles y aqui tambien hay que poder tocarlo. -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Localize MapBackground}" VerticalAlignment="Center" />
          <Button Grid.Row="2" Grid.Column="1"
                  Theme="{StaticResource TileColorSwatch}"
                  Width="60" Height="22" HorizontalAlignment="Left" Margin="0,0,0,4"
                  ToolTip.Tip="{Binding BackgroundColor.DisplayName, StringFormat='Fondo: {0}'}">
            <Grid ColumnDefinitions="*,Auto">
              <Border Grid.Column="0" Background="{Binding BackgroundColor.Brush}" />
              <TextBlock Grid.Column="1" Text="{Binding BackgroundColor.Hex}"
                         FontFamily="Consolas" FontSize="11" Width="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <ItemsControl ItemsSource="{Binding BackgroundChoices}" Width="152">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="entities:PaletteColor">
                      <Button Theme="{StaticResource TileColorSwatch}"
                              Width="34" Height="22" Margin="2"
                              ToolTip.Tip="{Binding DisplayName}"
                              Click="OnPaletteColorClick"
                              Command="{Binding $parent[ItemsControl].((vm:MapEditorViewModel)DataContext).PickBackgroundColorCommand}"
                              CommandParameter="{Binding}">
                        <Border Background="{Binding Brush}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- El tile de relleno con su dibujo al lado: un numero suelto no dice nada, y
               asi se ve lo que va a salir donde el mapa esta vacio. -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:Localize MapEmpty}" VerticalAlignment="Center"
                     ToolTip.Tip="{l:Localize MapEmptyTip}" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
            <NumericUpDown Width="100" ShowButtonSpinner="True" FormatString="0"
                           Minimum="0" Maximum="255" Increment="1"
                           Value="{Binding EmptyTile}" />
            <Border BorderBrush="{DynamicResource AppControlBorder}" BorderThickness="1" Margin="6,0,0,0"
                    Width="24" Height="24" VerticalAlignment="Center">
              <Image Source="{Binding EmptyTileImage.SpritePreview}"
                     Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <GridSplitter Grid.Row="2" Height="3" Background="{DynamicResource AppSeparator}" ResizeDirection="Rows" />

    <!-- Los dos orígenes de lo que se estampa -->
    <Grid Grid.Row="3">

    <TabControl x:Name="SourceTabs" Background="{DynamicResource AppPanelBackground}">

      <!-- En un mapa de supertiles no sale: una celda es un supertile entero, asi que un
           tile suelto no se puede colocar en ninguna parte. -->
      <TabItem Header="{l:Localize MapTilesTab}" IsVisible="{Binding !UsesSuperTiles}">
        <Border Background="Gray" Padding="4">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        AllowAutoHide="False">
            <!-- 32 columnas, las mismas que el editor y que el png: es la unica
                 disposicion en la que coger un rectangulo significa algo. -->
            <ItemsControl x:Name="TileChoices"
                          ItemsSource="{Binding TileChoices}"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          PointerPressed="OnTilesPressed"
                          PointerMoved="OnTilesMoved">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="32" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TileChoiceViewModel">
                  <!-- El recuadro va superpuesto y sin cambiar de grosor: un borde
                       alrededor separaria los tiles al seleccionar. -->
                  <Panel>
                    <Border BorderThickness="1,1,0,0" BorderBrush="Black"
                            Width="{Binding $parent[views:MapEditorView].TileSize}"
                            Height="{Binding $parent[views:MapEditorView].TileSize}">
                      <Image Source="{Binding Image.SpritePreview}" Stretch="Fill"
                             RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                    <Border Classes="mark" Classes.selected="{Binding IsSelected}" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="{l:Localize MapBlocksTab}">
        <Border Background="Gray" Padding="4">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        AllowAutoHide="False">
            <!-- Todos a la vista y tantos por fila como quepan: un bloque se reconoce por
                 su dibujo, no por su nombre. -->
            <ItemsControl ItemsSource="{Binding BlockChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlockChoiceViewModel">
                  <!-- Arriba y sin estirar: el WrapPanel da a toda la fila el alto del
                       bloque mas alto, y una casilla estirada le pasa ese alto de mas al
                       UniformGrid de dentro, que lo reparte entre sus filas. Un bloque de
                       dos filas al lado de uno de tres salia partido por la mitad. -->
                  <Border Classes="choice" Classes.selected="{Binding IsSelected}"
                          Background="#404040"
                          VerticalAlignment="Top"
                          PointerPressed="OnBlockPressed"
                          ToolTip.Tip="{Binding Label}">
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="{Binding Columns}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="entities:ImageMini">
                          <Image Source="{Binding SpritePreview}"
                                 Width="{Binding $parent[views:MapEditorView].TileSize}"
                                 Height="{Binding $parent[views:MapEditorView].TileSize}"
                                 Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>

      <!-- Sobre la tira de pestañas, que ahi sobra sitio y es donde se busca. -->
      <StackPanel Orientation="Horizontal" Margin="0,2,8,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top">
        <!-- Sin el X1: ocho pixeles por tile son ilegibles, y quien quiere ver mucho mapa
             de golpe aleja el lienzo, que para eso tiene pasos por debajo de x1. Arriba
             llega hasta X8 porque aqui se viene a reconocer el dibujo de un tile, no a
             tenerlos todos a la vista. El numero es el aumento de verdad, como en las
             demas tiras del programa. -->
        <RadioButton GroupName="MapTileZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X2" Tag="2" MinWidth="34" Margin="2" IsChecked="True"
                     IsCheckedChanged="OnTileZoomChanged" />
        <RadioButton GroupName="MapTileZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X3" Tag="3" MinWidth="34" Margin="2"
                     IsCheckedChanged="OnTileZoomChanged" />
        <RadioButton GroupName="MapTileZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X4" Tag="4" MinWidth="34" Margin="2"
                     IsCheckedChanged="OnTileZoomChanged" />
        <RadioButton GroupName="MapTileZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X6" Tag="6" MinWidth="34" Margin="2"
                     IsCheckedChanged="OnTileZoomChanged" />
        <RadioButton GroupName="MapTileZoom" Theme="{StaticResource ToggleRadioButton}"
                     Content="X8" Tag="8" MinWidth="34" Margin="2"
                     IsCheckedChanged="OnTileZoomChanged" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
