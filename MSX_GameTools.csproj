<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MSX_GameTools</RootNamespace>
    <AssemblyName>MSX_GameTools</AssemblyName>
    <!-- What every build says it is. A release takes its version from the tag instead, and
         the release workflow refuses a tag that does not match this one. -->
    <Version>0.2.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Este proyecto vive en la raiz del repositorio, asi que sus globs por defecto
       (**/*.cs, **/*.axaml) se tragarian los ficheros del proyecto de tests y los del
       submodulo tools/sass-MSX (el ensamblador de las ROMs de prueba, C# tambien). -->
  <ItemGroup>
    <Compile Remove="tests/**;tools/**" />
    <None Remove="tests/**;tools/**" />
    <EmbeddedResource Remove="tests/**;tools/**" />
    <AvaloniaXaml Remove="tests/**;tools/**" />
    <AvaloniaResource Remove="tests/**;tools/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Avalonia.Diagnostics se queda fuera: esta deprecado y congelado en 11.3.x, y aqui
         no lo usaba nadie —no hay una sola llamada a AttachDevTools—. Si algun dia se
         quieren las DevTools, el sucesor es AvaloniaUI.DiagnosticsSupport. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Iconos para las barras de herramientas. Independiente del tema base: son trazos
         que heredan el Foreground, asi que siguen a la variante como el resto. -->
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>

  <!-- La plantilla de la ROM de ejemplo viaja dentro del binario: al exportar se
       rellena y sale al lado de los ficheros de datos, para el ensamblador elegido. -->
  <ItemGroup>
    <None Remove="Templates/*.asm" />
    <EmbeddedResource Include="Templates/*.asm" />
  </ItemGroup>

</Project>
