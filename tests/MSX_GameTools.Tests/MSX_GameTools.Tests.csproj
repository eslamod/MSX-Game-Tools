<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 corre cada ensamblado de pruebas como su propio ejecutable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- xUnit v3 y no v2: no es una eleccion, es que Avalonia.Headless.XUnit 12 depende
         de xunit.v3.extensibility.core. Teniendo los dos en el grafo, cada atributo sale
         ambiguo y no compila nada. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <!-- Skia real: con el dibujado simulado de headless, WriteableBitmap.Lock() no
         devuelve memoria persistente y no se pueden comprobar los pixeles. -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MSX_GameTools.csproj" />
  </ItemGroup>

</Project>
